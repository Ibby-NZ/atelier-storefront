{
  "name": "atelier-store",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Atelier storefront — Astro + React islands reading from atelier-api.",
  "scripts": {
    "dev": "astro dev",
    "prestart": "node -e \"require('fs').mkdirSync('data/uploads', { recursive: true })\"",
    "start": "node ./server.mjs",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "lint": "eslint .",
    "seed:cms": "emdash seed --database ./data/emdash.db --uploads-dir ./data/uploads"
  },
  "dependencies": {
    "@astrojs/node": "^11.0.2",
    "@astrojs/react": "^6.0.1",
    "agentation": "^3.0.2",
    "astro": "^7.1.3",
    "better-sqlite3": "^12.11.1",
    "dotenv": "^17.4.2",
    "emdash": "^0.29.0",
    "express": "^5.2.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "globals": "^15.14.0"
  }
}
