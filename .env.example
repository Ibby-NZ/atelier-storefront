# Base URL of the atelier-api service. The PUBLIC_ prefix exposes it to browser
# islands (fetch calls run client-side) as well as server-rendered pages.
# No trailing slash.
PUBLIC_API_BASE_URL=http://localhost:3001

# Port for the production server (server.mjs / `npm start`). Defaults to 3041.
# `astro dev` keeps its own port (4321, set in astro.config.mjs).
# PORT=3041

# Staging gate (server.mjs / `npm start` only; `astro dev` is not gated).
# Both required — the server refuses to start without them unless
# SITE_AUTH_DISABLED=true is set explicitly (public launch).
SITE_AUTH_USER=
SITE_AUTH_PASS=
# SITE_AUTH_DISABLED=true

# Leave unset while staging: robots.txt (src/pages/robots.txt.js) blocks all
# crawlers, every page gets a noindex meta tag, and server.mjs adds an
# X-Robots-Tag header. robots.txt + meta are baked at BUILD time, the header is
# runtime — at real launch set ALLOW_INDEXING=true in BOTH envs and rebuild.
# ALLOW_INDEXING=true

# Renders the Agentation feedback toolbar on a BUILT deployment (it is always on
# under `astro dev` regardless). Set it on the Basic-Auth staging box so
# reviewers can annotate the real build. BUILD TIME — pages are prerendered, so
# changing it needs a rebuild, not just a pm2 restart. Unset it at public launch
# alongside ALLOW_INDEXING: with the flag off the toolbar is dead-coded out and
# shoppers get no widget.
# PUBLIC_AGENTATION=true

# Public origin of this deployment (no trailing slash), e.g.
# https://atelier-storefront.disrupted.co.nz. Two consumers, two lifecycles:
#
#  - BUILD TIME: feeds Astro's `site`, which the layout uses for
#    <link rel="canonical"> and og:url. Unset means those URLs bake as
#    http://localhost:4321, so set it (and rebuild) before the site is ever
#    indexable.
#  - RUN TIME: EmDash reads process.env.SITE_URL (or EMDASH_SITE_URL) to derive
#    the expected WebAuthn origin and rpId for passkey verification. Behind a
#    TLS-terminating proxy (Cloudflare/nginx) it otherwise falls back to the
#    INTERNAL request origin — http://<host> — while the browser signs
#    https://<host>, and every passkey registration/login dies with a generic
#    "Failed to verify admin setup". The real cause is only in the process log:
#    `[SETUP_VERIFY_ERROR] Error: Invalid origin: https://… not in [http://…]`.
#    EmDash caches the value on first read, so changing it needs a process
#    restart, not just a new request.
SITE_URL=
