---
// Makes a horizontal overflow row actually drivable with a mouse.
//
// `overflow-x: auto` is only half a scroller on a desktop pointer: a native
// scroller cannot be dragged, and the design hides the scrollbar — so the row
// reads as a stuck grid with its last tile clipped. Touch was always fine; this
// is the pointer half.
//
// It does NOT touch the wheel. See the note where that handler used to be: a
// row that converts deltaY into sideways travel also stops the page scrolling
// past it, which is worse than the problem it solves.
//
// Opt in with `data-drag-scroll` on the scrolling element. Nothing else on the
// page is touched, so any other row can adopt it by adding the attribute —
// the shared `BrandsRow.astro` does.
//
// Progressive: without JavaScript the row is still a native scroller — touch
// swipe, keyboard focus and Shift+wheel all keep working, and the tiles are
// links either way.
---

<script>
  // Runs on the first load AND after every client-side navigation
  // (<ClientRouter /> in Layout.astro swaps the page in place, and a
  // bundled script would otherwise run once for the whole session).
  document.addEventListener('astro:page-load', () => {
    // Bind every row now, and again whenever an island announces one it has
    // just rendered (`atelier-drag-scroll`, fired by the product page's
    // "Similar Products" row after its fetch). A bound row is marked so a
    // second pass never double-binds it.
    const bind = () => {
      const rows = document.querySelectorAll('[data-drag-scroll]:not([data-drag-bound])')
      rows.forEach((row) => row.setAttribute('data-drag-bound', ''))
      return rows
    }
    const rows = bind()
    document.addEventListener('atelier-drag-scroll', () => bindRows(bind()))

    const bindRows = (rows) => {
    for (const row of rows) {
      const canScroll = () => row.scrollWidth - row.clientWidth > 1

      // --- Wheel ---------------------------------------------------------------
      // **The vertical wheel is left alone, on purpose.** This used to map deltaY
      // onto scrollLeft so an ordinary mouse could drive the row; the cost was
      // that the row ate the page's own scroll for as long as the pointer was
      // over it, and since the maisons row is a full-width band most of the way
      // down the home page, that is most of the page — "when I scroll vertically
      // on this section it does not allow me" (page feedback, 1920x968 #13).
      //
      // A trackpad's sideways gesture sends deltaX and the row still handles that
      // natively, Shift+wheel still works, and the drag below is the pointer
      // affordance for a mouse. Trapping the page to save a mouse user one drag
      // was the wrong trade.

      // --- Drag ----------------------------------------------------------------
      // Mouse only: a touch pointer already pans the row natively, and taking it
      // over here would fight the platform's own inertia.
      //
      // **No `setPointerCapture`.** Capturing on pointerdown retargets the click
      // that follows to the capturing element, so every plain click landed on the
      // <ul> and no house ever opened. The pointer is tracked on `window` instead,
      // which follows it outside the row just as well and leaves click targeting
      // alone.
      let startX = 0
      let startLeft = 0
      let moved = false

      const onMove = (event) => {
        const travel = event.clientX - startX
        // A few pixels of slop, so a click that wobbles still opens the house.
        // The dragging class goes on only once it is a real drag, or a plain
        // click would flicker the cursor.
        if (!moved && Math.abs(travel) > 4) {
          moved = true
          row.classList.add('is-dragging')
        }
        if (!moved) return
        row.scrollLeft = startLeft - travel
        event.preventDefault()
      }

      const onUp = () => {
        window.removeEventListener('pointermove', onMove)
        window.removeEventListener('pointerup', onUp)
        window.removeEventListener('pointercancel', onUp)
        row.classList.remove('is-dragging')
      }

      row.addEventListener('pointerdown', (event) => {
        if (event.pointerType !== 'mouse' || event.button !== 0 || !canScroll()) return
        // Cleared here rather than after a suppressed click: a drag that ends on
        // empty space fires no click at all, and the flag would swallow the next
        // real one.
        moved = false
        startX = event.clientX
        startLeft = row.scrollLeft
        window.addEventListener('pointermove', onMove, { passive: false })
        window.addEventListener('pointerup', onUp)
        window.addEventListener('pointercancel', onUp)
      })

      // A drag that ends on a tile must not also navigate to that house. Capture
      // phase, because the anchor's own default would otherwise already be on its
      // way.
      row.addEventListener(
        'click',
        (event) => {
          if (!moved) return
          event.preventDefault()
          event.stopPropagation()
        },
        true
      )

      // Dragging a link or an image otherwise starts a native drag-and-drop and
      // the scroll stops dead a few pixels in.
      row.addEventListener('dragstart', (event) => {
        if (moved) event.preventDefault()
      })
    }
    }
    bindRows(rows)
  })
</script>
