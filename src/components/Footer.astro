---
import Wordmark from './Wordmark.astro'
import { getCollection } from 'astro:content'

// Site footer, 2026 direction (design: Figma 7307:930, repeated verbatim at the
// foot of the Brand and Product Page frames).
//
// One umber band over a hairline: the wordmark at 175.656px on the left, one
// row of 12px links on the right. It replaced the Maison footer's four link
// columns — the showroom addresses, phone, email and social links that lived
// there are still in src/lib/site.js and still render on /contact, which is
// where the design puts them.
//
// Privacy Policy and Terms & Conditions are the design's last two links and the
// only two with no route behind them. They render when (and only when) someone
// adds src/content/pages/privacy.md or terms.md — the page collection already
// drives /story and /contact the same way. Shipping the links against missing
// pages would put two 404s in the footer of every page on the site.
//
// getCollection, not getEntry: a missing getEntry logs "Entry page → privacy
// was not found" on every page of every build, and here a miss is the expected
// state, not a fault.
const pageIds = new Set((await getCollection('page')).map((entry) => entry.id))

const links = [
  { href: '/products', label: 'Products' },
  { href: '/brands', label: 'Brands' },
  { href: '/story', label: 'Our Story' },
  { href: '/resources', label: 'Journal' },
  { href: '/trade-application', label: 'Trade Account' },
  { href: '/contact', label: 'Contact' },
  pageIds.has('privacy') ? { href: '/privacy', label: 'Privacy Policy' } : null,
  pageIds.has('terms') ? { href: '/terms', label: 'Terms & Conditions' } : null,
].filter(Boolean)
---

<footer class="site-footer">
  <div class="container site-footer-inner">
    <a class="site-footer-brand" href="/" aria-label="Atelier Textiles — home">
      <Wordmark width="175.656px" />
    </a>

    <nav class="site-footer-nav" aria-label="Footer">
      <ul>
        {links.map((link) => <li><a href={link.href}>{link.label}</a></li>)}
      </ul>
    </nav>
  </div>
</footer>
