---
// Editorial gallery footer: wordmark + brand line on the left, link groups on
// the right, a hairline base rule carrying the copyright and the standing
// "Indicative" note. The existing /story, /contact and /order-lookup links are
// preserved (order-lookup is the only route a guest has to reach their order).
const year = new Date().getFullYear()

const groups = [
  {
    heading: 'The Collection',
    links: [
      { href: '/products', label: 'Products' },
      { href: '/brands', label: 'Brands' },
      { href: '/resources', label: 'Resources' },
    ],
  },
  {
    heading: 'The Studio',
    links: [
      { href: '/story', label: 'Story' },
      { href: '/contact', label: 'Contact' },
      { href: '/trade-application', label: 'Trade application' },
    ],
  },
  {
    heading: 'Your Account',
    links: [
      { href: '/account', label: 'My account' },
      { href: '/order-lookup', label: 'Order lookup' },
      { href: '/cart', label: 'Cart' },
    ],
  },
]
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-top">
      <div class="footer-brand">
        <span class="brand-mark">ATELIER</span>
        <span class="brand-sub">TEXTILES</span>
        <p class="footer-line">Curators of global design excellence.</p>
        <p class="footer-place">Parnell, Auckland — Aotearoa New Zealand</p>
      </div>

      <nav class="footer-groups" aria-label="Footer">
        {
          groups.map((group) => (
            <div class="footer-group">
              <h2 class="footer-heading">{group.heading}</h2>
              <ul>
                {group.links.map((link) => (
                  <li>
                    <a href={link.href}>{link.label}</a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </nav>
    </div>

    <div class="footer-base">
      <p class="footer-copy">&copy; {year} Atelier Textiles.</p>
      <p class="footer-note">
        All prices indicative and subject to confirmation.
      </p>
    </div>
  </div>
</footer>
