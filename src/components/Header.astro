---
import CartIndicator from './CartIndicator.jsx'
import RequestIndicator from './RequestIndicator.jsx'
import AccountNav from './AccountNav.jsx'
import Wordmark from './Wordmark.astro'

// Site header, 2026 direction (design: Figma Header 3376:24 / 3376:4, drawn on
// every one of the four frames — home 7307:617, Brand 9350:479, Product Page
// 9350:788, Sign in 9350:361).
//
// One row: nav left, the wordmark absolutely centred, Contact + three 24px
// icons right. No announcement bar and no mega-menu — the design has neither,
// and the mega-menu's job (by type / by application / the houses) is the
// library's own facet sidebar.
//
// Two themes, one markup. `overlay` floats the header over the first band of a
// bleed page and reverses the type to bone (the home hero, a house banner,
// sign-in); without it the header sits on the page ground in umber over a
// hairline. `Layout.astro` passes it through from the page.
//
// The nav labels are the client's own (Userback, 25 Aug 2026): Shop for
// /products and Our Brands for /brands, Story for /story, Journal for
// /resources. Story became Our Story (Userback, Sept 2026) — the footer, the
// home CTA and the page's own heading already read that way, so the nav was
// the last place still calling it Story. There is no Home item — the wordmark
// is the way home. The LABEL is all that moved; every href, every `isActive`
// test and every link into these routes elsewhere on the site is unchanged.
const { overlay = false } = Astro.props

const links = [
  { href: '/products', label: 'Shop' },
  { href: '/brands', label: 'Our Brands' },
  { href: '/bespoke', label: 'Bespoke' },
  { href: '/story', label: 'Our Story' },
  { href: '/resources', label: 'Journal' },
]

const current = Astro.url.pathname
const isActive = (href) => current === href || current.startsWith(`${href}/`)
---

{/* `overlay="light"` floats the header over a LIGHT band (the shop and journal
    banners on bg/subtle, Figma 9457:5255) and keeps its paper-theme type; plain
    `overlay` reverses it for a photograph. */}
<header
  class:list={[
    'site-header',
    { 'site-header--overlay': overlay, 'site-header--overlay-light': overlay === 'light' },
  ]}
>
  <div class="container site-header-inner">
    <nav class="site-nav" aria-label="Primary">
      <ul>
        {
          links.map((link) => (
            <li>
              <a href={link.href} aria-current={isActive(link.href) ? 'page' : undefined}>
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <a class="site-wordmark" href="/" aria-label="Atelier Textiles — home">
      <Wordmark width="200px" />
    </a>

    <div class="site-utils">
      <a class="site-util-link" href="/contact" aria-current={isActive('/contact') ? 'page' : undefined}>
        Contact
      </a>
      {/* Search is the library itself: it opens with the search field the
          shopper is reaching for, and there is no separate search route to
          send them to. */}
      <a class="site-icon" href="/products" aria-label="Search the collection">
        <svg
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          aria-hidden="true"
        >
          <path d="M13.7069 15.0002L19.0001 20.2929" stroke-linecap="round"></path>
          <circle cx="9.5" cy="9.5" r="6.5"></circle>
        </svg>
      </a>
      <AccountNav client:load />
      {/* The fabric request list. Renders nothing until it holds something, so
          the drawn header keeps its three icons and a shopper who has built a
          list can still reach it from any page. */}
      <RequestIndicator client:load />
      <CartIndicator client:load />
      {/* The burger, phones and tablets only (chrome.css hides it above
          1024px). Two lines that fold into a cross when the menu is open. */}
      <button
        class="site-burger"
        type="button"
        aria-expanded="false"
        aria-controls="site-menu"
        aria-label="Menu"
      >
        <span class="site-burger-line"></span>
        <span class="site-burger-line"></span>
      </button>
    </div>
  </div>

  {/* The full-screen menu. Closed, it is clipped to nothing at the top edge;
      opening unclips it downward, closing clips it back up. Dark ground, the
      links in the display face, each arriving a beat after the last. */}
  <div class="site-menu" id="site-menu" inert>
    <nav class="site-menu-nav" aria-label="Menu">
      <ul>
        {
          [...links, { href: '/contact', label: 'Contact' }].map((link, index) => (
            <li style={`--i: ${index}`}>
              <a href={link.href} aria-current={isActive(link.href) ? 'page' : undefined}>
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <p class="site-menu-foot" style={`--i: ${links.length + 1}`}>
      <a href="/account">Account</a>
      <a href="/cart">Cart</a>
      <a href="/trade-application">Trade account</a>
    </p>
  </div>
</header>

<script>
  // The menu. Re-armed on every page-load (client-side navigation swaps the
  // header) and closed before a swap, so a page never arrives with the menu
  // open. Scroll is locked on <html> while it is up; Escape and any link in it
  // close it.
  document.addEventListener('astro:page-load', () => {
    const header = document.querySelector('.site-header')
    const button = header && header.querySelector('.site-burger')
    const menu = header && header.querySelector('.site-menu')
    if (!header) return

    const set = (open) => {
      header.classList.toggle('is-menu-open', open)
      if (button) button.setAttribute('aria-expanded', String(open))
      if (menu) menu.toggleAttribute('inert', !open)
      document.documentElement.classList.toggle('menu-open', open)
    }

    set(false)

    // Scroll behaviour: the bar leaves on the way down and comes back on the
    // way up, on the page's own ground (dark on a dark page, cream on a light
    // one), and is its natural self again at the top — transparent over a
    // hero, plain on a contained page (page feedback, Sept 2026). A floating
    // (overlay) header is `position: absolute` at rest and goes `fixed`
    // (`is-pinned`) once the page has scrolled past it; a contained header is
    // sticky by CSS and only needs hiding. Menu open = never hidden.
    const overlay = header.classList.contains('site-header--overlay')
    let lastY = window.scrollY
    let ticking = false
    const onScroll = () => {
      if (ticking) return
      ticking = true
      window.requestAnimationFrame(() => {
        ticking = false
        const y = window.scrollY
        const height = header.offsetHeight
        if (y <= 8) {
          header.classList.remove('is-pinned', 'is-hidden')
        } else {
          if (overlay) header.classList.add('is-pinned')
          if (header.classList.contains('is-menu-open')) {
            header.classList.remove('is-hidden')
          } else if (y > lastY + 4 && y > height) {
            header.classList.add('is-hidden')
          } else if (y < lastY - 4) {
            header.classList.remove('is-hidden')
          }
        }
        lastY = y
      })
    }
    window.addEventListener('scroll', onScroll, { passive: true })
    onScroll()

    if (button) button.addEventListener('click', () => set(!header.classList.contains('is-menu-open')))
    if (menu) menu.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => set(false)))
    const onKey = (event) => {
      if (event.key === 'Escape') set(false)
    }
    document.addEventListener('keydown', onKey)
    document.addEventListener(
      'astro:before-swap',
      () => {
        set(false)
        document.removeEventListener('keydown', onKey)
        window.removeEventListener('scroll', onScroll)
      },
      { once: true }
    )
  })
</script>
