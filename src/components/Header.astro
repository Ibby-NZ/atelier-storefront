---
import CartIndicator from './CartIndicator.jsx'
import AccountNav from './AccountNav.jsx'

// Editorial brand-world TopBar (design handoff): centred ATELIER / TEXTILES
// wordmark, centred uppercase nav whose active item is claret with a 2px
// underline meeting the header hairline, and utilities pinned right. Cart and
// account are React islands (live state); the rest are plain links.
// aria-current marks the active page for a11y and styling.
//
// Responsive without JS: below 640px the CSS reflows this same markup to
// wordmark + utilities on one line with the nav on a scrollable row beneath
// (see src/styles/chrome.css).
const links = [
  { href: '/', label: 'Home' },
  { href: '/products', label: 'Products' },
  { href: '/brands', label: 'Brands' },
  { href: '/resources', label: 'Resources' },
  { href: '/story', label: 'Story' },
  { href: '/contact', label: 'Contact' },
]

const current = Astro.url.pathname
const isActive = (href) =>
  href === '/' ? current === '/' : current.startsWith(href)
---

<header class="site-header">
  <div class="container site-header-inner">
    <a class="brand" href="/" aria-label="Atelier Textiles — home">
      <span class="brand-mark">ATELIER</span>
      <span class="brand-sub">TEXTILES</span>
    </a>

    <nav class="site-nav" aria-label="Primary">
      <ul>
        {
          links.map((link) => (
            <li>
              <a
                href={link.href}
                aria-current={isActive(link.href) ? 'page' : undefined}
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="site-utils">
      <AccountNav client:load />
      <CartIndicator client:load />
    </div>
  </div>
</header>
