---
import CartIndicator from './CartIndicator.jsx'

// Primary site navigation. Cart is a React island (live count); the rest are
// plain links. aria-current marks the active page for a11y and styling.
const links = [
  { href: '/', label: 'Home' },
  { href: '/products', label: 'Products' },
  { href: '/brands', label: 'Brands' },
  { href: '/resources', label: 'Resources' },
  { href: '/story', label: 'Story' },
  { href: '/contact', label: 'Contact' },
  { href: '/account', label: 'Account' },
]

const current = Astro.url.pathname
const isActive = (href) =>
  href === '/' ? current === '/' : current.startsWith(href)
---

<header class="site-header">
  <div class="container">
    <a class="brand" href="/">ATELIER TEXTILES</a>
    <nav class="site-nav" aria-label="Primary">
      <ul>
        {
          links.map((link) => (
            <li>
              <a
                href={link.href}
                aria-current={isActive(link.href) ? 'page' : undefined}
              >
                {link.label}
              </a>
            </li>
          ))
        }
        <li>
          <CartIndicator client:load />
        </li>
      </ul>
    </nav>
  </div>
</header>
