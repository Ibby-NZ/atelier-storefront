---
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'
import { Agentation } from 'agentation'
import '../styles/global.css'

const {
  title = 'Atelier Textiles',
  description = 'Fine textiles for makers and trade — fabrics, finished goods, and the houses behind them.',
  image,
  type = 'website',
  // `bleed` hands the page the full width of <main>: no .container wrapper and
  // no block padding, so a page can paint edge-to-edge bands (the Maison
  // direction's linen page headers) and place its own containers inside them.
  // Default false — every existing page keeps the centred container.
  bleed = false,
  // `overlay` floats the header over the page's first band and reverses its
  // type to bone — the 2026 direction's treatment for a screen that opens on a
  // full-bleed photograph (the home hero, a house banner, sign-in). It only
  // makes sense with `bleed`, since a contained page has paper under the
  // header, and the page is responsible for leaving the band tall enough to
  // hold the header plus its own copy.
  overlay = false,
  // `dark` puts the page on the direction's umber ground instead of the cream
  // canvas — the treatment /story has, for a page that does not paint its own
  // bands. It is NOT a dark mode: the site is light by design, has no toggle
  // and no `prefers-color-scheme` rule; this is one page choosing the dark half
  // of the same palette. The header takes the ground with it (see chrome.css)
  // and the footer stays the cream band it is on every page, /story included.
  dark = false,
  // `darkGround` opts the page into DARK MODE's page ground — the header
  // toggle's theme, which is a different thing from `dark` above: `dark` is one
  // page choosing the umber half of the light palette, this one says "when the
  // reader has asked for dark mode, this body may go dark too".
  //
  // It is a per-page opt-in because dark mode is a curated set of overrides
  // (src/styles/dark-mode.css), not a token swap: only the 2026 marketing
  // surfaces have been drawn dark. Without the gate, an un-redesigned Maison
  // page (cart, checkout, account, the journal, the order flows, admin) would
  // get a dark <main> under light content. Set on /products, /brands,
  // /brands/[slug] and /products/[slug]; NOT on the home or /story, whose bands
  // are full-bleed so <main> never shows.
  darkGround = false,
} = Astro.props

// Staging is noindex by default; baked in at build time for prerendered pages.
// ALLOW_INDEXING=true in the build environment (real launch) drops it — the
// same flag flips robots.txt (src/pages/robots.txt.js) and the X-Robots-Tag
// header (server.mjs).
const allowIndexing = import.meta.env.ALLOW_INDEXING === 'true'

// Canonical / social URLs. `site` is not set in astro.config.mjs, so fall back
// to the request URL's own origin — both branches yield an absolute URL.
const base = Astro.site ?? Astro.url
const canonical = new URL(Astro.url.pathname, base).href
const socialImage = image ? new URL(image, base).href : null

const SITE_NAME = 'Atelier Textiles'
// Fraunces starts at 300: the Maison direction sets large display italics at
// that weight (see library.css `.library-head h1 em`).
const FONTS =
  'https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300..600;1,9..144,300..600&family=IBM+Plex+Mono:wght@400;500&family=Inter:wght@400;500;600&display=swap'
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    {/* The browser chrome above the page — the phone's own top bar. It has to
        follow the page's ground or it reads as the seam a mismatched header
        does. */}
    <meta name="theme-color" content={dark ? '#18100C' : '#F9F4ED'} />
    {!allowIndexing && <meta name="robots" content="noindex, nofollow" />}
    <title>{title}</title>
    <link rel="canonical" href={canonical} />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={SITE_NAME} />
    {socialImage && <meta property="og:image" content={socialImage} />}
    <meta
      name="twitter:card"
      content={socialImage ? 'summary_large_image' : 'summary'}
    />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {socialImage && <meta name="twitter:image" content={socialImage} />}

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href={FONTS} />

    {/*
      Dark mode, applied BEFORE first paint. The header's toggle only WRITES
      `atelier_theme` and flips `data-theme` on click — it explicitly relies on
      this script having restored the stored choice by the time it runs (see the
      comment at the top of Header.astro's script), so without it dark mode was
      forgotten on every navigation and the header button came up "off" on a page
      the reader had already darkened.

      `is:inline` is load-bearing: a plain <script> is bundled and deferred, which
      would apply the theme after the cream ground had already painted — a white
      flash on every page load, which is the whole thing this script exists to
      avoid. It only sets `data-theme`; `theme-color` needs `document.body` to
      know whether this page has a dark ground at all, so Header's own sync()
      owns that once the body exists.
    */}
    <script is:inline>
      try {
        const stored = localStorage.getItem('atelier_theme')
        if (stored === 'dark' || stored === 'light') {
          document.documentElement.dataset.theme = stored
        }
      } catch (e) {
        // Private mode / storage disabled: the site stays light, which is the
        // default anyway.
      }
    </script>
  </head>
  <body class:list={{ 'theme-dark': dark, 'has-dark-ground': darkGround }}>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header overlay={overlay} />
    <main id="main" class={bleed ? 'main-bleed' : undefined}>
      {
        bleed ? (
          <slot />
        ) : (
          <div class="container">
            <slot />
          </div>
        )
      }
    </main>
    <Footer />
    {/* Agentation annotation toolbar. Always on under `astro dev`; on a built
        deployment it renders only when PUBLIC_AGENTATION=true, which is how the
        Basic-Auth staging site collects visual feedback on the real build.
        Vite statically replaces both operands at build time, so with the flag
        unset the branch is dead code and a public launch ships no toolbar —
        leave it unset in the launch checklist next to ALLOW_INDEXING.
        BUILD-TIME, like SITE_URL/ALLOW_INDEXING: every storefront page is
        `prerender = true`, so flipping the flag needs a rebuild, not a restart.
        client:only because the toolbar is a React portal into document.body
        with no server-renderable output. */}
    {(import.meta.env.DEV || import.meta.env.PUBLIC_AGENTATION === 'true') && (
      <Agentation client:only="react" />
    )}
  </body>
</html>
