---
import { ClientRouter } from 'astro:transitions'
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'
import { Agentation } from 'agentation'
import '../styles/global.css'

const {
  title = 'Atelier Textiles',
  description = 'Fine textiles for makers and trade — fabrics, finished goods, and the houses behind them.',
  image,
  type = 'website',
  // `bleed` hands the page the full width of <main>: no .container wrapper and
  // no block padding, so a page can paint edge-to-edge bands (the Maison
  // direction's linen page headers) and place its own containers inside them.
  // Default false — every existing page keeps the centred container.
  bleed = false,
  // `overlay` floats the header over the page's first band and reverses its
  // type to bone — the 2026 direction's treatment for a screen that opens on a
  // full-bleed photograph (the home hero, a house banner, sign-in). It only
  // makes sense with `bleed`, since a contained page has paper under the
  // header, and the page is responsible for leaving the band tall enough to
  // hold the header plus its own copy.
  overlay = false,
  // `dark` puts the page on the direction's umber ground instead of the cream
  // canvas — the treatment /story has, for a page that does not paint its own
  // bands. It is NOT a dark mode: the site is light by design, has no toggle
  // and no `prefers-color-scheme` rule; this is one page choosing the dark half
  // of the same palette. The header takes the ground with it (see chrome.css)
  // and the footer stays the cream band it is on every page, /story included.
  dark = false,
} = Astro.props

// Staging is noindex by default; baked in at build time for prerendered pages.
// ALLOW_INDEXING=true in the build environment (real launch) drops it — the
// same flag flips robots.txt (src/pages/robots.txt.js) and the X-Robots-Tag
// header (server.mjs).
const allowIndexing = import.meta.env.ALLOW_INDEXING === 'true'

// Agentation annotation toolbar. Always on under `astro dev`; on a built
// deployment it renders only when PUBLIC_AGENTATION=true, which is how the
// Basic-Auth staging site collects visual feedback on the real build. Vite
// statically replaces both operands at build time, so with the flag unset the
// branch is dead code and a public launch ships no toolbar — leave it unset in
// the launch checklist next to ALLOW_INDEXING. BUILD-TIME, like
// SITE_URL/ALLOW_INDEXING: every storefront page is prerendered, so flipping the
// flag needs a rebuild, not a restart.
// Hoisted out of the template because the Userback launcher below has to know
// whether there is an Agentation bubble to sit above.
const showAgentation =
  import.meta.env.DEV || import.meta.env.PUBLIC_AGENTATION === 'true'

// Userback feedback widget. SELF-GATING: no token, no widget — so switching it
// off at public launch is "unset PUBLIC_USERBACK_TOKEN", not a second flag to
// remember. Build-time for the same reason Agentation is: the token is baked
// into every prerendered page, so a change needs a rebuild, not a pm2 restart.
// The value is a *widget access token*, not an API key — it is designed to ship
// publicly in page source, which is why it carries the PUBLIC_ prefix.
const userbackToken = import.meta.env.PUBLIC_USERBACK_TOKEN

// Canonical / social URLs. `site` is not set in astro.config.mjs, so fall back
// to the request URL's own origin — both branches yield an absolute URL.
const base = Astro.site ?? Astro.url
const canonical = new URL(Astro.url.pathname, base).href
const socialImage = image ? new URL(image, base).href : null

const SITE_NAME = 'Atelier Textiles'
// Fraunces starts at 300: the Maison direction sets large display italics at
// that weight (see library.css `.library-head h1 em`).
const FONTS =
  'https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300..600;1,9..144,300..600&family=IBM+Plex+Mono:wght@400;500&family=Inter:wght@400;500;600&display=swap'
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {/* Client-side navigation with a View Transitions crossfade between pages
        (the animation itself is set in chrome.css). Every bundled script on
        the site now listens for astro:page-load rather than running at
        module load, or it would fire once per session instead of once per
        page — the rotator, the drag rows and the headline reveal below all do. */}
    <ClientRouter />
    <meta name="description" content={description} />
    {/* The browser chrome above the page — the phone's own top bar. It has to
        follow the page's ground or it reads as the seam a mismatched header
        does. */}
    <meta name="theme-color" content={dark ? '#18100C' : '#F9F4ED'} />
    {!allowIndexing && <meta name="robots" content="noindex, nofollow" />}
    <title>{title}</title>
    <link rel="canonical" href={canonical} />
    {/* The favicon is the wordmark's own geometric "A" in public/ (svg first,
        png for Safari, which still ignores svg icons; the 180px
        apple-touch-icon covers the home-screen bookmark): the client's tile of
        17 Sep 2026 — tan on the dark ground. It was a Didot serif A before,
        which the CRM still carries. */}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.png" type="image/png" sizes="96x96" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={SITE_NAME} />
    {socialImage && <meta property="og:image" content={socialImage} />}
    <meta
      name="twitter:card"
      content={socialImage ? 'summary_large_image' : 'summary'}
    />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {socialImage && <meta name="twitter:image" content={socialImage} />}

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href={FONTS} />

  </head>
  <body class:list={{ 'theme-dark': dark }}>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header overlay={overlay} />
    <main id="main" class={bleed ? 'main-bleed' : undefined}>
      {
        bleed ? (
          <slot />
        ) : (
          <div class="container">
            <slot />
          </div>
        )
      }
    </main>
    <Footer />
    {/* Headline reveal: marks every headline below the fold and reveals each
        one, with a timed transition, as it enters the viewport. The CSS for
        `[data-reveal]` is in direction-2026.css beside the note on why this is
        a triggered transition and not a scroll-driven one. */}
    <script>
      const HEADS = 'h1, h2, h3, .photo-band-title, .tile-title'
      const stillness = window.matchMedia('(prefers-reduced-motion: reduce)').matches

      // Re-armed on every page-load (first paint and each client-side
      // navigation) and torn down before the swap, so an observer never
      // outlives the document it was watching.
      document.addEventListener('astro:page-load', () => {
        if (stillness || !('IntersectionObserver' in window)) return
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue
              entry.target.classList.add('is-revealed')
              io.unobserve(entry.target)
            }
          },
          // Fires once 15% of the headline is in; the transition then plays.
          { threshold: 0.15 }
        )
        // Below the fold only: a headline already on screen must never flash
        // from visible to hidden and back while the observer catches up.
        const mark = (root) => {
          const heads = root.matches && root.matches(HEADS) ? [root] : []
          for (const el of root.querySelectorAll ? root.querySelectorAll(HEADS) : []) heads.push(el)
          for (const el of heads) {
            if (el.hasAttribute('data-reveal')) continue
            if (el.getBoundingClientRect().top <= window.innerHeight) continue
            el.setAttribute('data-reveal', '')
            io.observe(el)
          }
        }
        mark(document.body)
        // Islands render their headings after hydration and fetches (the
        // product grid, the account panels). Mark those the same way as they
        // land, so "every headline" means the ones React adds too.
        const mo = new MutationObserver((records) => {
          for (const record of records) {
            for (const node of record.addedNodes) {
              if (node.nodeType === Node.ELEMENT_NODE) mark(node)
            }
          }
        })
        mo.observe(document.body, { childList: true, subtree: true })
        document.addEventListener(
          'astro:before-swap',
          () => {
            io.disconnect()
            mo.disconnect()
          },
          { once: true }
        )
      })
    </script>
    {/* client:only because the toolbar is a React portal into document.body
        with no server-renderable output. The flag is resolved in the
        frontmatter — see `showAgentation`. */}
    {showAgentation && <Agentation client:only="react" />}

    {/* ClientRouter swaps <head> and <body> on every navigation, and BOTH
        widgets style themselves by appending <style>/<link> to <head> at
        runtime — Agentation once, at module load; Userback as its CDN script
        boots — while Userback also builds its launcher straight into <body>.
        The swap keeps only what the incoming document also carries, so the
        first client-side navigation stripped both sheets and the launcher:
        Agentation's island remounted and rendered as raw buttons in flow
        under the footer, and the Userback bubble simply vanished (page
        feedback, Sept 2026). Carry them across — the sheets into the incoming
        head, the launcher into the incoming body; Agentation's island remounts
        by itself and needs only its sheets back. Userback's second sheet is an
        anonymous <style>, told apart by content. `is:inline` so it is emitted
        only with a widget to protect; ClientRouter runs an identical inline
        script once per session, so the listener is never stacked. */}
    {
      (showAgentation || userbackToken) && (
        <script is:inline>
          document.addEventListener('astro:before-swap', (event) => {
            const next = event.newDocument
            const sheets = document.head.querySelectorAll(
              'style[id^="feedback-tool-"], style#agentation-color-tokens, link.userback-css'
            )
            for (const el of sheets) next.head.append(el)
            for (const el of document.head.querySelectorAll('style:not([id]):not([data-vite-dev-id])')) {
              if (el.textContent.includes('.userback')) next.head.append(el)
            }
            for (const el of document.body.querySelectorAll('.userback-button-container')) {
              next.body.append(el)
            }
          })
        </script>
      )
    }

    {/* Userback feedback widget — Userback's own async loader snippet, verbatim
        apart from the token and the placement line: put the config on
        `window.Userback`, then append the CDN script, which self-initialises
        from `access_token` when it lands. There is no `Userback.init()` call to
        order against, which is why the settings must be assigned BEFORE the
        append. Async, so it never blocks paint; no npm package, so nothing
        enters the bundle; and with no token configured the whole block is
        absent and Userback is never contacted. */}
    {
      userbackToken && (
        <Fragment>
          {showAgentation && (
            /* Userback and Agentation both park at bottom 1.25rem / right
               1.25rem, so without this the launchers land exactly on top of
               each other — and Userback wins, because its z-index is
               2147483644 against Agentation's 100000. Agentation's collapsed
               bubble is 44px, i.e. a top edge at 64px; 76px clears it with a
               12px gap.
               Target `.userback-button`, NOT the `.userback-button-container`
               Userback's own "overwriting CSS" page points at: that wrapper is
               a zero-height full-width div, and the launcher inside it carries
               its own bottom/right. `-se` scopes the rule to the south-east
               placement set below, so moving the widget in the dashboard
               cannot leave a stray offset behind.
               `is:inline` matters — Astro extracts a plain <style> into the
               page's CSS bundle regardless of the condition around it, so a
               bundled rule would also lift the launcher on a build with no
               Agentation to sit above. */
            <style is:inline>
              .userback-button.userback-button-se { bottom: 76px !important; }
            </style>
          )}
          <script define:vars={{ userbackToken }}>
            window.Userback = window.Userback || {}
            Userback.access_token = userbackToken
            // `se` (south-east) rather than Userback's own default `e`
            // (middle-right): "above Agentation" only means anything if both
            // launchers are in the same corner. Drop this line if the Userback
            // dashboard should own the placement instead. Set before the script
            // is appended — the widget reads this object as it boots.
            Userback.widget_settings = { position: 'se' }
            ;(function (d) {
              var s = d.createElement('script')
              s.async = true
              s.src = 'https://static.userback.io/widget/v1.js'
              ;(d.head || d.body).appendChild(s)
            })(document)
          </script>
        </Fragment>
      )
    }
  </body>
</html>
