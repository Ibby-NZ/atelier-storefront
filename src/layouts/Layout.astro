---
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'
import { Agentation } from 'agentation'
import '../styles/global.css'

const {
  title = 'Atelier Textiles',
  description = 'Fine textiles for makers and trade — fabrics, finished goods, and the houses behind them.',
  image,
  type = 'website',
  // `bleed` hands the page the full width of <main>: no .container wrapper and
  // no block padding, so a page can paint edge-to-edge bands (the Maison
  // direction's linen page headers) and place its own containers inside them.
  // Default false — every existing page keeps the centred container.
  bleed = false,
  // `overlay` floats the header over the page's first band and reverses its
  // type to bone — the 2026 direction's treatment for a screen that opens on a
  // full-bleed photograph (the home hero, a house banner, sign-in). It only
  // makes sense with `bleed`, since a contained page has paper under the
  // header, and the page is responsible for leaving the band tall enough to
  // hold the header plus its own copy.
  overlay = false,
  // `darkGround` marks a page as a participant in the dark-mode toggle: it adds
  // `has-dark-ground` to <body>, which is what the [data-theme="dark"] rules in
  // dark-mode.css hang the shared chrome on. Without it, a page's <main> and its
  // (non-overlay) header stay light even in dark mode — so the un-redesigned
  // Maison pages (cart, checkout, account, …) keep their light bodies and are
  // never left with a dark header over a light page. The footer darkens on every
  // page regardless, so the toggle always has a visible effect. Set it on the
  // 2026 marketing pages the feedback named (see dark-mode.css header).
  darkGround = false,
} = Astro.props

// Staging is noindex by default; baked in at build time for prerendered pages.
// ALLOW_INDEXING=true in the build environment (real launch) drops it — the
// same flag flips robots.txt (src/pages/robots.txt.js) and the X-Robots-Tag
// header (server.mjs).
const allowIndexing = import.meta.env.ALLOW_INDEXING === 'true'

// Canonical / social URLs. `site` is not set in astro.config.mjs, so fall back
// to the request URL's own origin — both branches yield an absolute URL.
const base = Astro.site ?? Astro.url
const canonical = new URL(Astro.url.pathname, base).href
const socialImage = image ? new URL(image, base).href : null

const SITE_NAME = 'Atelier Textiles'
// Fraunces starts at 300: the Maison direction sets large display italics at
// that weight (see library.css `.library-head h1 em`).
const FONTS =
  'https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300..600;1,9..144,300..600&family=IBM+Plex+Mono:wght@400;500&family=Inter:wght@400;500;600&display=swap'
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {/* theme-color mirrors the top-of-page chrome (the header), so it is the
        dark ground ONLY where the page actually paints a dark header — dark mode
        AND a darkGround page. An un-themed light page (cart, checkout, …) must
        never tint the mobile browser bar dark. Declared before the script below
        so that script can update it. */}
    <meta name="theme-color" content="#F7F2E9" />
    {/* Dark-mode no-flash: apply the saved theme (and the matching theme-color)
        to <html> BEFORE the body paints, so a returning dark-mode visitor never
        sees a flash of the light ground. `define:vars` makes this an inline
        script (runs in document order, before the stylesheet) and hands it the
        page's own darkGround flag. The site is light unless a choice is stored —
        dark is explicit opt-in, not derived from prefers-color-scheme, matching
        the warm-paper brand. */}
    <script define:vars={{ darkGround }}>
      (function () {
        try {
          var stored = localStorage.getItem('atelier_theme')
          var theme = stored === 'dark' ? 'dark' : 'light'
          document.documentElement.dataset.theme = theme
          var meta = document.querySelector('meta[name="theme-color"]')
          if (meta) {
            meta.setAttribute('content', theme === 'dark' && darkGround ? '#19100C' : '#F7F2E9')
          }
        } catch (e) {
          document.documentElement.dataset.theme = 'light'
        }
      })()
    </script>
    <meta name="description" content={description} />
    {!allowIndexing && <meta name="robots" content="noindex, nofollow" />}
    <title>{title}</title>
    <link rel="canonical" href={canonical} />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={SITE_NAME} />
    {socialImage && <meta property="og:image" content={socialImage} />}
    <meta
      name="twitter:card"
      content={socialImage ? 'summary_large_image' : 'summary'}
    />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {socialImage && <meta name="twitter:image" content={socialImage} />}

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href={FONTS} />
  </head>
  <body class={darkGround ? 'has-dark-ground' : undefined}>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header overlay={overlay} />
    <main id="main" class={bleed ? 'main-bleed' : undefined}>
      {
        bleed ? (
          <slot />
        ) : (
          <div class="container">
            <slot />
          </div>
        )
      }
    </main>
    <Footer />
    {/* Agentation annotation toolbar. Always on under `astro dev`; on a built
        deployment it renders only when PUBLIC_AGENTATION=true, which is how the
        Basic-Auth staging site collects visual feedback on the real build.
        Vite statically replaces both operands at build time, so with the flag
        unset the branch is dead code and a public launch ships no toolbar —
        leave it unset in the launch checklist next to ALLOW_INDEXING.
        BUILD-TIME, like SITE_URL/ALLOW_INDEXING: every storefront page is
        `prerender = true`, so flipping the flag needs a rebuild, not a restart.
        client:only because the toolbar is a React portal into document.body
        with no server-renderable output. */}
    {(import.meta.env.DEV || import.meta.env.PUBLIC_AGENTATION === 'true') && (
      <Agentation client:only="react" />
    )}
  </body>
</html>
