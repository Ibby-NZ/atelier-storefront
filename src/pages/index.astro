---
export const prerender = true // storefront pages stay static; EmDash routes render on-demand
import { Image, getImage } from 'astro:assets'
import Layout from '../layouts/Layout.astro'
import CollectionHero from '../components/CollectionHero.astro'
import { safeFetch } from '../lib/api.js'
import {
  brandDesignCounts,
  collectionArtwork,
  collectionHref,
  featuredCollections,
  houseLabel,
  HERO_SLOTS,
  LATEST_SLOTS,
  pickCollections,
  pickFeature,
} from '../lib/home.js'

// Commissioned banner art, shipped with the site rather than fetched.
//
// Everything else on this page still takes its photograph from the catalogue,
// and that is still the right default — a collection tile should show the
// collection. These do not: they are the bands the client art-directed, and a
// band the catalogue fills at random cannot be art-directed at all. They live
// in `src/assets` (not `public/`) so the build emits sized webp derivatives
// instead of serving a 2560px JPEG to a phone.
import natureOperaBanner from '../assets/img/natures-opera-hero-banner.jpg'
import larsenBanner from '../assets/img/larsen-hero-banner.jpg'
import manuelCanovasBanner from '../assets/img/manuel-canovas-hero-banner.jpg'
import exploreTypeArt from '../assets/img/explore-type-bg.jpg'
import exploreApplicationArt from '../assets/img/explore-application-bg.jpg'
import featuredCollectionArt from '../assets/img/featured-collection-image.jpg'
import designHousesArt from '../assets/img/design-brands-banner-bg.jpg'
import manifestoArt from '../assets/img/aterlier-about-bg.jpg'

// Home, 2026 direction (design: Figma "Atelier Home page", node 7307:617).
// Section order is the mock's, verbatim: full-bleed collection hero, the two
// shop banners, the latest-collections row, the espresso "Atelier" manifesto,
// the featured collection, and the design-houses band.
//
// The mock's own content — Nature's Opera, Giverny, Mazan, Cappuccino,
// Feuillage, Larsen 2024 — is all LIVE DATA: every one of them is a row of
// GET /catalogue/collections, carrying its own name, description, photograph
// and house. So the page is merchandised out of the collections endpoint
// rather than out of hardcoded copy — and since W7 the CHOICE is live too:
// `featured_rank`, set by the office in the CRM, replaces the slug arrays this
// frontmatter used to carry.
//
// Built at build time. Everything degrades to an empty section when the API is
// down (safeFetch never throws), so the build always succeeds — the storefront
// is a static build and must never depend on the API being up to compile. The
// fetch is anonymous, so no trade pricing is ever baked into this page.
//
// The page is `bleed`: every band paints edge to edge and carries its own
// `.container`, which keeps its copy aligned with the site header and footer.
// It is also `overlay` — the mock floats the header over the hero photograph
// rather than stacking it above, so the hero owns the top of the viewport and
// `.home-hero` is sized to hold the header inside it.

const { data: catalogue } = await safeFetch('/catalogue/products?limit=100')
const products = catalogue?.products ?? []

const { data: collectionList } = await safeFetch('/catalogue/collections')
const collections = collectionList?.collections ?? []

// Houses, for the featured collection's fact list — the collections endpoint
// carries the house's slug and name but not where it works from.
const { data: brandList } = await safeFetch('/catalogue/brands')
const brands = brandList?.brands ?? []

// --- Commissioned art, keyed to the collection it was shot for --------------
// WHAT the page features is no longer decided here: `featured_rank` is, set by
// the office in the CRM. These registries only say which photograph belongs to
// which collection, which is a fact about the art rather than a merchandising
// choice — the office can reorder, add and drop featured collections without
// anyone touching this file.
//
// Keyed on the `(house, collection)` PAIR, because a collection slug is unique
// per house and never globally: a slug-keyed map would hand another maison's
// "2024" this one's photograph. See collectionKey() in lib/home.js.
//
// A featured collection with no entry here is normal, not an omission — it
// falls back to its own catalogue photograph and then to a plain band, and
// never to somebody else's picture (collectionArtwork()).
const HERO_ART = {
  'de-le-cuona/nature-s-opera': natureOperaBanner,
  'larsen/larsen-2024': larsenBanner,
  'manuel-canovas/manuel-canovas-2024': manuelCanovasBanner,
}

// The featured band's portrait is a different frame from a hero banner (40vw
// beside the copy, not 88vh behind it), so it is its own registry — and it is
// what decides WHICH featured collection the band shows. See pickFeature().
const FEATURE_ART = {
  'larsen/larsen-2024': featuredCollectionArt,
}

// The two doors into the catalogue. Both land on the library itself rather than
// on a pre-filtered grid: "by type" and "by application" name the library's own
// two facet dimensions, and picking a value here would promise one thing and
// show another. /products can never be empty, which is the standing rule for
// every link out of this page.
const BANNERS = [
  { title: 'Shop by type', cta: 'Shop now', href: '/products' },
  { title: 'Shop by application', cta: 'Shop now', href: '/products' },
]

const MANIFESTO = {
  title: 'Atelier',
  pronunciation: '[ at-l-yey ]',
  body: "True to the French word for workshop, Atelier is a space built for creation. We've curated thousands of luxury fabrics, wall coverings, and furnishings from the world's leading design capitals. Step into our workspace and discover the inspiration to bring your bespoke interiors to life.",
  cta: 'Our Story',
  href: '/story',
}

const HOUSES = {
  title: "The World's Finest Design Houses",
  body: 'From the legendary textile mills of Europe to innovative global creators, we are a boutique importer and distributor of the world’s most luxurious furnishing brands.',
  cta: 'View brands',
  href: '/brands',
}

// --- Collections -----------------------------------------------------------
// Designs held per house — the third rung of collectionHref()'s ladder, so a
// tile for a house we hold nothing from goes to the house page rather than to
// an empty grid. de Le Cuona and No.9 Thompson are both in that position on the
// seeded catalogue, and both are named by the design.
const designsPerHouse = brandDesignCounts(products)
const houseDesigns = (collection) => designsPerHouse[collection?.brand?.slug] ?? 0
const hrefFor = (collection) => collectionHref(collection, houseDesigns(collection))

// The office's list, in the office's order. The DATABASE owns that order; this
// page owns the composition — the first three are the hero, what is left leads
// the latest row, and one of them carries the featured band. None of that is in
// the schema, deliberately.
const featuredList = featuredCollections(collections)
const heroCollections = featuredList.slice(0, HERO_SLOTS)

const heroSlides = heroCollections.map((collection) => ({
  key: collection.slug,
  name: collection.name,
  // Two of the three the office features today are "<house> <year>", so the
  // house line is dropped rather than stuttering it above the title — see
  // houseLabel().
  house: houseLabel(collection.name, collection.brand?.name),
  description: collection.description ?? null,
  href: hrefFor(collection),
  ...collectionArtwork(HERO_ART, collection),
}))

// The band shows the collection its commissioned portrait was shot for, which
// is why reordering the hero in the CRM does not move it. Null — nothing
// featured has a picture at all — omits the band rather than framing nothing.
const featuredLive = pickFeature(featuredList, FEATURE_ART)
const featured = featuredLive && {
  name: featuredLive.name,
  description: featuredLive.description ?? null,
  href: hrefFor(featuredLive),
  ...collectionArtwork(FEATURE_ART, featuredLive),
}

// The fact list beside the featured collection. Every row is live data, and a
// row with nothing behind it is dropped rather than shown empty — so the band
// still reads as finished when the API is down. `product_count` is deliberately
// NOT one of them: collection membership is staff-assigned in the CRM and the
// seed assigns none, so it is 0 for every collection and would read as "nothing
// in it". Designs held from the HOUSE is the honest figure, and it is also
// where the "Explore collection" link lands (collectionHref's second rung).
const featuredHouse = brands.find((brand) => brand.slug === featuredLive?.brand?.slug) ?? null
const featuredDesigns = houseDesigns(featuredLive)
const featuredFacts = [
  { label: 'House', value: featuredLive?.brand?.name ?? null },
  { label: 'Origin', value: featuredHouse?.country ?? null },
  { label: 'Designs held', value: featuredDesigns > 0 ? String(featuredDesigns) : null },
].filter((fact) => fact.value)

// The office's choice first — the featured collections the hero did not take —
// then the rest of the catalogue to fill the row out. Nothing already on the
// page appears twice.
const latest = pickCollections([...featuredList.slice(HERO_SLOTS), ...collections], {
  count: LATEST_SLOTS,
  exclude: [...heroCollections, featuredLive].filter(Boolean),
})

// --- Photography -----------------------------------------------------------
// The bands that carry no collection of their own are art-directed outright
// (the imports at the top): the manifesto band was the last one drawing a
// picture from the catalogue via bandPhotographs(), and it takes committed art
// like the rest, so it cannot land on a product shot that disappears under its
// scrim. The hero and the featured band are the two that follow a collection,
// so they follow the art chain above instead.
//
// Art-directed bands paint their photograph as a background, so they go through
// getImage() rather than <Image>: same webp derivative, no <img> to place.
const [typeArt, applicationArt, housesArt, manifestoImage] = await Promise.all(
  [exploreTypeArt, exploreApplicationArt, designHousesArt, manifestoArt].map((src) =>
    getImage({ src, format: 'webp' })
  )
)

const banners = [
  { ...BANNERS[0], image: typeArt.src },
  { ...BANNERS[1], image: applicationArt.src },
]

const bandStyle = (image) => (image ? `background-image: url(${image})` : undefined)
---

<Layout
  title="Atelier Textiles — Curators of global design excellence"
  description="Fine fabrics and finished goods for makers and trade, sourced from houses across Aotearoa and beyond."
  image={heroSlides[0]?.image?.src ?? heroSlides[0]?.src ?? undefined}
  bleed
  overlay
>
  <CollectionHero
    slides={heroSlides}
    title="Atelier Textiles — curators of global design excellence"
  />

  <section class="tile-wall">
    {
      banners.map((banner) => (
        <a class="tile" style={bandStyle(banner.image)} href={banner.href}>
          <span class="tile-body">
            <span class="tile-title">{banner.title}</span>
            <span class="cta-underline cta-underline-light cta-underline-lg">
              {banner.cta}
            </span>
          </span>
        </a>
      ))
    }
  </section>

  {
    latest.length > 0 && (
      <section class="home-collections">
        <div class="container home-collections-head">
          <h2>Latest collections</h2>
          <a class="cta-underline cta-underline-lg" href="/products">
            View all
          </a>
        </div>
        {/* Horizontal scroller: the design runs the row past the right edge of
            the frame, so it bleeds rather than wrapping to a second line. */}
        <ul class="home-collection-row">
          {latest.map((collection) => (
            <li>
              <a href={hrefFor(collection)}>
                {collection.image_url ? (
                  <img src={collection.image_url} alt={collection.name} loading="lazy" />
                ) : (
                  <span class="home-collection-media weave" aria-hidden="true" />
                )}
                <span class="home-collection-meta">
                  <span class="home-collection-name">{collection.name}</span>
                  {collection.brand?.name && (
                    <span class="badge-ochre">{collection.brand.name}</span>
                  )}
                </span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  <section class="photo-band home-manifesto" style={bandStyle(manifestoImage.src)}>
    <div class="container">
      <div class="home-manifesto-body">
        <h2 class="photo-band-title">
          {MANIFESTO.title} <span class="photo-band-title-sub">{MANIFESTO.pronunciation}</span>
        </h2>
        <p>{MANIFESTO.body}</p>
        <a class="cta-underline cta-underline-light" href={MANIFESTO.href}>{MANIFESTO.cta}</a>
      </div>
    </div>
  </section>

  {
    featured && (
      <section class="home-featured">
        <div class="container home-featured-inner">
          <div class="home-featured-media">
            {/* Commissioned portrait, or the collection's own catalogue
                photograph — the band only renders when it has one of the two,
                so there is never an empty frame here. */}
            {featured.image ? (
              <Image
                src={featured.image}
                alt={featured.name}
                widths={[622, 933, 1244]}
                sizes="(max-width: 1024px) 100vw, 40vw"
                format="webp"
                loading="lazy"
              />
            ) : (
              <img src={featured.src} alt={featured.name} loading="lazy" />
            )}
          </div>
          <div class="home-featured-body">
            <p class="badge-ochre">Featured collection</p>
            <h2>{featured.name}</h2>
            {featured.description && <p class="home-featured-copy">{featured.description}</p>}
            {featuredFacts.length > 0 && (
              /* The house page's own fact list (editorial.css `.house-facts`),
                 reused verbatim — same figure, same rows, nothing new to style. */
              <dl class="house-facts home-featured-facts">
                {featuredFacts.map((fact) => (
                  <div class="house-fact">
                    <dt>{fact.label}</dt>
                    <dd>{fact.value}</dd>
                  </div>
                ))}
              </dl>
            )}
            <a class="cta-underline" href={featured.href}>
              Explore collection
            </a>
          </div>
        </div>
      </section>
    )
  }

  <section class="photo-band home-houses" style={bandStyle(housesArt.src)}>
    <div class="photo-band-body">
      <div class="container photo-band-row">
        <h2 class="photo-band-title">{HOUSES.title}</h2>
        <div class="photo-band-aside">
          <p>{HOUSES.body}</p>
          <a class="cta-underline cta-underline-light" href={HOUSES.href}>{HOUSES.cta}</a>
        </div>
      </div>
    </div>
  </section>
</Layout>
