---
export const prerender = true // storefront pages stay static; EmDash routes render on-demand
import Layout from '../../layouts/Layout.astro'
import AdminBrands from '../../components/AdminBrands.jsx'

// Brand + collection admin. Everything is a client:load island: the admin
// catalogue endpoints are per-request (session cookie + backoffice role), so
// nothing here can be prerendered. The island resolves the current user at
// runtime and redirects non-backoffice visitors away before fetching anything.
---

<Layout
  title="Brands — Atelier Textiles"
  description="Back-office brand and collection management for Atelier Textiles staff."
>
  <p class="breadcrumb"><a href="/admin/">← Admin</a></p>

  <section class="page-intro">
    <h1>Brands</h1>
    <p>Add houses, edit their details, and manage the collections beneath them.</p>
  </section>

  <AdminBrands client:load />
</Layout>
