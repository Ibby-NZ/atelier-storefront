---
export const prerender = true // storefront pages stay static; EmDash routes render on-demand
import Layout from '../../layouts/Layout.astro'

// Back-office hub. Deliberately static and island-free: it holds no data, only
// links. Each destination is its own client:load island that gates on the
// signed-in user, so nothing sensitive is exposed by this page being public —
// a customer who guesses the URL sees three links and is bounced from each.
---

<Layout
  title="Admin — Atelier Textiles"
  description="Back-office tools for Atelier Textiles staff."
>
  <section class="page-intro">
    <h1>Admin</h1>
    <p>Back-office tools. Staff accounts only.</p>
  </section>

  <ul class="admin-hub-list">
    <li>
      <a href="/admin/orders">
        <strong>Order queue</strong>
        <span class="admin-muted">
          Review, edit and progress orders through their lifecycle.
        </span>
      </a>
    </li>
    <li>
      <a href="/admin/brands">
        <strong>Brands</strong>
        <span class="admin-muted">Add houses and manage their collections.</span>
      </a>
    </li>
    <li>
      <a href="/admin/products">
        <strong>Products</strong>
        <span class="admin-muted">
          Add fabrics and finished goods, edit specs and colourways.
        </span>
      </a>
    </li>
  </ul>
</Layout>
