---
export const prerender = true // storefront pages stay static; EmDash routes render on-demand
import Layout from '../../layouts/Layout.astro'
import AdminProducts from '../../components/AdminProducts.jsx'

// Product + colourway admin. Everything is a client:load island: the admin
// catalogue endpoints are per-request (session cookie + backoffice role), so
// nothing here can be prerendered. The island resolves the current user at
// runtime and redirects non-backoffice visitors away before fetching anything.
// A `?brand=<id>` query (linked from the brands page) preselects the filter.
---

<Layout
  title="Products — Atelier Textiles"
  description="Back-office product and colourway management for Atelier Textiles staff."
>
  <p class="breadcrumb"><a href="/admin/">← Admin</a></p>

  <section class="page-intro">
    <h1>Products</h1>
    <p>Add fabrics and finished goods, edit their details, and manage colourways.</p>
  </section>

  <AdminProducts client:load />
</Layout>
