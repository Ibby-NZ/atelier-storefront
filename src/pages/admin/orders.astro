---
export const prerender = true // storefront pages stay static; EmDash routes render on-demand
import Layout from '../../layouts/Layout.astro'
import AdminOrders from '../../components/AdminOrders.jsx'

// Back-office order queue (US-023, FR-7). Everything is a client:load island:
// the admin endpoints are per-request (session cookie + backoffice role), so
// nothing is prerendered. The island resolves the current user at runtime and
// redirects non-backoffice visitors away — no order data is fetched for them.
---

<Layout
  title="Order queue — Atelier Textiles"
  description="Back-office order management for Atelier Textiles staff."
>
  <section class="page-intro">
    <h1>Order queue</h1>
    <p>Review, edit, and progress website orders through their lifecycle.</p>
  </section>

  <AdminOrders client:load />
</Layout>
