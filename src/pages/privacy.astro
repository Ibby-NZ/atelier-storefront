---
export const prerender = true // storefront pages stay static; EmDash routes render on-demand
import Layout from '../layouts/Layout.astro'
import { getEntry, render } from 'astro:content'

// Privacy Policy — one of the design's last two footer links (Figma 7307:930).
// Rendered from the `page` content collection (id "privacy") exactly the way
// /story and /contact are, so the client can write it without a code change.
// Until the markdown exists, Footer.astro leaves the link out (it checks the
// collection) and this page renders its empty state — no placeholder legal
// copy is invented here.
const entry = await getEntry('page', 'privacy')
const Content = entry ? (await render(entry)).Content : null
const title = entry?.data.title ?? 'Privacy Policy'
---

<Layout title={`${title} — Atelier Textiles`}>
  <article class="content-page">
    <h1>{title}</h1>
    {
      Content ? (
        <div class="prose">
          <Content />
        </div>
      ) : (
        <p class="empty-state">This page has no content yet.</p>
      )
    }
  </article>
</Layout>
