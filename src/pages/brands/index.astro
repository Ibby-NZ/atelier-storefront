---
export const prerender = false // on-demand so a newly created brand appears without a rebuild
import { getCollection } from 'astro:content'
import { getImage } from 'astro:assets'
import Layout from '../../layouts/Layout.astro'
import { safeFetch } from '../../lib/api.js'
import { listEmdashBrandPages } from '../../lib/emdash.js'
import {
  countWord,
  featuredHouses,
  FOCUS_SLOTS,
  houseArtwork,
  houseMeta,
} from '../../lib/houses.js'

// Brands index, 2026 direction (design: Figma "Brands Page", node 9379:3562).
//
// Three sections plus a closing band: the page header, the "in focus" strip of
// the houses the OFFICE has featured, the full directory as hairline rows, and
// the sourcing enquiry. The page is `bleed` so the espresso band paints edge to
// edge; each section carries its own `.container` to stay aligned with header
// and footer.
//
// Rendered on demand — staff add brands through the CRM at runtime, so a
// prerendered grid would be stale until the next deploy. safeFetch never
// throws, so an API outage renders the error state rather than a 500.
const { data, error } = await safeFetch('/catalogue/brands')
const brands = data?.brands ?? []

// The catalogue supplies fallback photography for a house with no editorial
// page yet, and the design counts behind the featured band's "Explore
// collection" ladder. **This request is anonymous, so it is the PUBLIC
// SUBSET** — the trade gate keeps every represented house's designs out of it,
// which is why editorial imagery is the only picture most houses can have
// here. Same 100 limit as the homepage.
const { data: catalogue } = await safeFetch('/catalogue/products?limit=100')
const products = catalogue?.products ?? []

// The featured-collection band at the foot of the page: the office's own
// choice (featured_rank on collections, set in the CRM), decorated with the
// collection's own catalogue photograph. A featured collection with no
// photograph cannot art-direct a half-page frame, so the band takes the first
// featured one that carries a picture, and is omitted when none does.
const { data: collectionsBody } = await safeFetch('/catalogue/collections')
const featured = featuredCollections(collectionsBody?.collections ?? [])
const feature = featured.find((collection) => collection.image_url) ?? null
const designCounts = brandDesignCounts(products)

// Editorial imagery, resolved exactly as /brands/[slug] resolves it: the EmDash
// CMS is the editor of record and WINS over the markdown baseline. Spreading
// the EmDash map last is that precedence — per house, not per field.
const imageEntries = (pairs) => Object.fromEntries(pairs.filter(([, image]) => image))

const emPages = await listEmdashBrandPages()
const mdPages = await getCollection('brandPage')

const editorialImages = {
  ...imageEntries(mdPages.map((page) => [page.data.brand, page.data.slideshow?.[0] ?? null])),
  ...imageEntries(emPages.map((page) => [page.slug, page.slideshow?.[0] ?? null])),
}

// First photographed design per house — the second rung of the artwork chain,
// under the house's own editorial page. Keep-first, so the house's leading
// design wins. Since the gate this can only ever hold the workroom: a
// represented house's products are not in an anonymous list at all, so
// editorial imagery is the only picture such a house can have here, and
// `editorialImages` already wins over this map.
const productImages = products.reduce((images, product) => {
  const slug = product.brand?.slug
  if (!slug || !product.image_url || images[slug]) return images
  return { ...images, [slug]: product.image_url }
}, {})

const designsPerHouse = products.reduce((counts, product) => {
  const slug = product.brand?.slug
  return slug ? { ...counts, [slug]: (counts[slug] ?? 0) + 1 } : counts
}, {})

// Decorated in the order the API gave, because that order is load-bearing: it
// is the tie-break between two houses the office has put at the same rank.
// The directory sorts a COPY, so the strip below still sees rank order.
const decorated = brands.map((brand) => ({
  ...brand,
  meta: houseMeta(brand),
  held: designsPerHouse[brand.slug] ?? 0,
  image: houseArtwork({ editorial: editorialImages, catalogue: productImages }, brand),
}))

const houses = [...decorated].sort((a, b) => a.name.localeCompare(b.name))

// The strip is the office's own choice — `featured_rank`, set in the CRM and
// carried by /catalogue/brands — and no longer a guess derived from
// `is_international` plus a design count. That guess could not be changed by
// anyone in the office, and the trade gate had already flattened it to
// alphabetical: every represented house reads 0 designs to an anonymous
// visitor, so the count tie-break was inert.
//
// A featured house with no photograph is KEPT and paints the weave ground
// (houseArtwork's third rung). Dropping it would silently delete the office's
// choice from the page, and under the gate an unphotographed featured house is
// the normal case rather than an edge one. The heading still counts what is
// actually in the strip, so featuring one or two houses reads as an edit.
const featured = featuredHouses(decorated, FOCUS_SLOTS)

const heroImage = await getImage({ src: brandsBanner, format: 'webp', width: 2200 })
---

<Layout
  title="The houses — Atelier Textiles"
  description="The maisons we represent in Aotearoa — French, Italian and British houses, and our own workroom."
  bleed
  overlay
>
  <section
    class="photo-band house-hero"
    style={`background-image: url(${heroImage.src});`}
  >
    <div class="container photo-band-body">
      <div class="photo-band-row">
        <h1 class="photo-band-title">The World's Finest Design Houses</h1>
        <div class="photo-band-aside">
          <p>
            From the legendary textile mills of Europe to innovative global
            creators, we are a boutique importer and distributor of the world's
            most luxurious furnishing brands.
          </p>
        </div>
      </div>
    </div>
  </section>

  {
    error && (
      <div class="container house-index-state">
        <p class="error-state">
          Could not load the houses: {error} Please try again shortly, or
          <a href="/contact"> get in touch</a>.
        </p>
      </div>
    )
  }

  {
    !error && houses.length === 0 && (
      <div class="container house-index-state">
        <p class="empty-state">No houses to show yet.</p>
      </div>
    )
  }

  {
    featured.length > 0 && (
      <section class="container house-focus">
        <p class="eyebrow-brass">In focus</p>
        <h2>
          {countWord(featured.length)}{' '}
          <em>{featured.length === 1 ? 'maison' : 'maisons'}</em>
        </h2>
        <div class="house-focus-grid">
          {featured.map((house) => (
            <a class="house-focus-card" href={`/brands/${house.slug}`}>
              <span class="scrim-tile house-focus-media">
                {
                  // No <img> is ever emitted without a source: a house with no
                  // photograph of its own gets the shared weave ground, the
                  // same stand-in the house page's collection tiles use.
                  house.image ? (
                    <img src={house.image} alt="" loading="lazy" />
                  ) : (
                    <span class="scrim-tile-media weave"></span>
                  )
                }
                <span class="scrim-tile-label">{house.name}</span>
              </span>
              <span class="house-focus-note">
                {house.meta && <span class="house-focus-meta">{house.meta}</span>}
                {
                  // Omitted rather than rendered as "0 designs held", which is
                  // what the anonymous count now says for every represented
                  // house — and would read as "we hold nothing from them"
                  // instead of "these are held for the trade". The house page
                  // itself carries that sentence (see brands/[slug].astro).
                  house.held > 0 && (
                    <span class="house-focus-held">
                      {house.held} {house.held === 1 ? 'design' : 'designs'} held
                    </span>
                  )
                }
              </span>
            </a>
          ))}
        </div>
        <ul class="house-wall-grid">
          {houses.map((house) => (
            <li>
              <a class="house-card" href={`/brands/${house.slug}`}>
                {
                  /* The mock centres each maison's own logotype on the tile.
                     No logo assets exist in the catalogue, so the house NAME
                     stands in, set in the display face — swap to an image the
                     day a logo library lands. No <img> is ever emitted without
                     a source: an unphotographed house paints the weave. */
                }
                <span class:list={['house-card-media', { weave: !house.image }]}>
                  {house.image && <img src={house.image} alt="" loading="lazy" />}
                  <span class="house-card-logo">{house.name}</span>
                </span>
                <span class="house-card-name">{house.name}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  {
    feature && (
      <section class="house-feature">
        <div
          class="house-feature-media"
          style={`background-image: url(${feature.image_url});`}
          role="img"
          aria-label={`${feature.name} — ${feature.brand?.name ?? 'featured collection'}`}
        >
        </div>
        <div class="house-feature-body">
          <p class="badge-ochre">Featured collection</p>
          <h2>{feature.name}</h2>
          {feature.description && <p class="house-feature-copy">{feature.description}</p>}
          <a
            class="cta-underline"
            href={collectionHref(feature, designCounts[feature.brand?.slug] ?? 0)}
          >
            Explore collection
          </a>
        </div>
      </section>
    )
  }
</Layout>
