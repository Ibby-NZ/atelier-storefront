---
export const prerender = false // on-demand so a newly created brand appears without a rebuild
import Layout from '../../layouts/Layout.astro'
import { safeFetch } from '../../lib/api.js'

// Brands index: every house we represent, sourced live from the catalogue API.
// Rendered on demand — staff add brands through /admin/brands at runtime, so a
// prerendered grid would be stale until the next deploy. safeFetch never
// throws, so an API outage renders the error state rather than a 500 (and the
// build, which no longer calls the API at all, stays offline-safe). Each card
// links to the brand page, which enriches the API brand with editorial content.
const { data, error } = await safeFetch('/catalogue/brands')
const brands = data?.brands ?? []
---

<Layout title="Brands — Atelier Textiles">
  <section class="page-intro">
    <p class="page-eyebrow">Our makers</p>
    <h1>The <em>houses</em></h1>
    <p>The houses we represent and the stories behind them.</p>
  </section>

  {error && <p class="error-state">Could not load brands: {error}</p>}

  {
    !error && brands.length === 0 && (
      <p class="empty-state">No brands to show yet.</p>
    )
  }

  <section class="card-grid">
    {
      brands.map((brand) => (
        <a class="card brand-card" href={`/brands/${brand.slug}`}>
          <h2>{brand.name}</h2>
          {brand.country && <p class="brand-meta">{brand.country}</p>}
          {brand.story && <p>{brand.story}</p>}
        </a>
      ))
    }
  </section>
</Layout>
