---
export const prerender = false // on-demand so a newly created brand appears without a rebuild
import { getCollection } from 'astro:content'
import Layout from '../../layouts/Layout.astro'
import { safeFetch } from '../../lib/api.js'
import { listEmdashBrandPages } from '../../lib/emdash.js'
import { countWord, houseMeta } from '../../lib/houses.js'

// Brands index, Maison direction. The redesign commit took the header, footer,
// library, home, product detail and the brand DETAIL page; this index was left
// on the old generic `.card-grid` of bordered boxes, which is why it read as a
// different website. It is rebuilt here out of the same shared figures the rest
// of the direction already uses — brass rule, scrim tiles, hairline index rows,
// espresso band — so nothing new is invented and the page inherits every later
// change to those primitives.
//
// Three sections plus a closing band: the page header, an "in focus" strip of
// photographed houses, the full directory as hairline rows, and the sourcing
// enquiry. The page is `bleed` so the espresso band paints edge to edge; each
// section carries its own `.container` to stay aligned with header and footer.
//
// Rendered on demand — staff add brands through the CRM at runtime, so a
// prerendered grid would be stale until the next deploy. safeFetch never throws,
// so an API outage renders the error state rather than a 500.
const { data, error } = await safeFetch('/catalogue/brands')
const brands = data?.brands ?? []

// The catalogue is fetched for two reasons, neither of which is a product list:
// it supplies the design counts that decide which houses lead the page, and it
// supplies fallback photography for a house with no editorial page yet. Same
// 100 limit as the homepage, which covers the whole website-visible catalogue.
const { data: catalogue } = await safeFetch('/catalogue/products?limit=100')
const products = catalogue?.products ?? []

// Editorial imagery, resolved exactly as /brands/[slug] resolves it: the EmDash
// CMS is the editor of record and WINS over the markdown baseline. Spreading the
// EmDash map last is that precedence — per house, not per field.
const imageEntries = (pairs) => Object.fromEntries(pairs.filter(([, image]) => image))

const emPages = await listEmdashBrandPages()
const mdPages = await getCollection('brandPage')

const editorialImages = {
  ...imageEntries(mdPages.map((page) => [page.data.brand, page.data.slideshow?.[0] ?? null])),
  ...imageEntries(emPages.map((page) => [page.slug, page.slideshow?.[0] ?? null])),
}

// First photographed design per house — the stand-in when a house has no
// editorial page. Keep-first, so the house's own leading design wins.
const productImages = products.reduce((images, product) => {
  const slug = product.brand?.slug
  if (!slug || !product.image_url || images[slug]) return images
  return { ...images, [slug]: product.image_url }
}, {})

const designsPerHouse = products.reduce((counts, product) => {
  const slug = product.brand?.slug
  return slug ? { ...counts, [slug]: (counts[slug] ?? 0) + 1 } : counts
}, {})

const houses = brands
  .map((brand) => ({
    ...brand,
    meta: houseMeta(brand),
    held: designsPerHouse[brand.slug] ?? 0,
    image: editorialImages[brand.slug] ?? productImages[brand.slug] ?? null,
  }))
  .sort((a, b) => a.name.localeCompare(b.name))

// The strip leads with the international houses we hold the most designs from
// AND can show a photograph of. Alphabetical order would lead with whoever sorts
// first rather than with anything a shopper can browse, and an unphotographed
// house would be a grey rectangle beside two photographs.
const FEATURE_COUNT = 3
const featured = houses
  .filter((house) => house.is_international && house.image)
  .sort((a, b) => b.held - a.held || a.name.localeCompare(b.name))
  .slice(0, FEATURE_COUNT)

const houseCount = houses.length
---

<Layout
  title="The houses — Atelier Textiles"
  description="The maisons we represent in Aotearoa — French, Italian and British houses, and our own workroom."
  bleed
>
  <section class="container house-index-head">
    <div class="brass-rule"></div>
    <p class="eyebrow-wide">Our maisons</p>
    <h1>The <em>houses</em></h1>
    <p class="house-index-lede">
      The houses we represent and the stories behind them — each held here by the
      metre, cut to order.
    </p>
    {
      houseCount > 0 && (
        <p class="house-index-count">
          {houseCount} {houseCount === 1 ? 'house' : 'houses'} represented
        </p>
      )
    }
  </section>

  {
    error && (
      <div class="container house-index-state">
        <p class="error-state">
          Could not load the houses: {error} Please try again shortly, or
          <a href="/contact"> get in touch</a>.
        </p>
      </div>
    )
  }

  {
    !error && houseCount === 0 && (
      <div class="container house-index-state">
        <p class="empty-state">No houses to show yet.</p>
      </div>
    )
  }

  {
    featured.length > 0 && (
      <section class="container house-focus">
        <p class="eyebrow-brass">In focus</p>
        <h2>
          {countWord(featured.length)} <em>maisons</em>
        </h2>
        <div class="house-focus-grid">
          {featured.map((house) => (
            <a class="house-focus-card" href={`/brands/${house.slug}`}>
              <span class="scrim-tile house-focus-media">
                <img src={house.image} alt="" loading="lazy" />
                <span class="scrim-tile-label">{house.name}</span>
              </span>
              <span class="house-focus-note">
                {house.meta && <span class="house-focus-meta">{house.meta}</span>}
                {house.held > 0 && (
                  <span class="house-focus-held">
                    {house.held} {house.held === 1 ? 'design' : 'designs'} held
                  </span>
                )}
              </span>
            </a>
          ))}
        </div>
      </section>
    )
  }

  {
    houseCount > 0 && (
      <section class="container house-directory">
        <div class="section-head">
          <h2>Every <em>house</em></h2>
          <a href="/products">Browse the library</a>
        </div>
        <ul class="index-list">
          {houses.map((house) => (
            <li>
              <a href={`/brands/${house.slug}`}>
                <span class="index-name">{house.name}</span>
                {house.meta && <span class="index-meta">{house.meta}</span>}
              </a>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  <section class="band-dark house-enquiry">
    <div class="container">
      <div class="band-dark-head">
        <div>
          <p class="eyebrow-brass">Sourcing</p>
          <h2>Looking for a house <em>we do not list?</em></h2>
        </div>
        <a class="band-dark-link" href="/contact">Talk to us</a>
      </div>
      <p class="house-enquiry-copy">
        We source beyond the houses shown here. Tell us the design, the reference
        or the mill and we will find it.
      </p>
    </div>
  </section>
</Layout>
