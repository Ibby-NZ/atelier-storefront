---
export const prerender = false // live: API brand + EmDash/markdown editorial overlay
import { getCollection, render } from 'astro:content'
import { PortableText } from 'emdash/ui'
import Layout from '../../layouts/Layout.astro'
import { apiFetch, ApiError, safeFetch } from '../../lib/api.js'
import { collectionTiles } from '../../lib/collections.js'
import { getEmdashBrandPage } from '../../lib/emdash.js'
import { countWord, foundedYear } from '../../lib/houses.js'

// One brand page, Maison direction (design: "Maison Brand"), resolved per
// request so a brand created in /admin/brands or a page published in the EmDash
// CMS appears without a rebuild.
//
// Section order is the handoff's: full-bleed 58vh banner, the intro column
// beside the facts list, the collection tiles, then the espresso related-reading
// band. The page is `bleed` so the banner and the espresso band paint edge to
// edge; each section carries its own `.container`.
const { slug } = Astro.params

// The brand itself comes from the live catalogue API. apiFetch (not safeFetch)
// because the two failure modes need different handling: a 404 means "no such
// brand" (an editorial-only page may still exist), while any other failure
// means the API is down and we must NOT 404 a brand that really exists.
let brand = null
let apiDown = false
try {
  const body = await apiFetch(`/catalogue/brands/${encodeURIComponent(slug)}`)
  brand = body?.brand ?? null
} catch (err) {
  if (!(err instanceof ApiError) || err.status !== 404) apiDown = true
}

// Editorial precedence: EMDASH WINS OVER MARKDOWN here. This deliberately
// diverges from /resources, where markdown wins — brand pages are handed to the
// CMS as the editor of record (it is the whole point of wiring them through
// EmDash), while the markdown files under src/content/brands stay as the
// offline baseline that ships with the repo. Precedence is per PAGE, not per
// field: the markdown entry is only read when the CMS has nothing for this
// slug, so a page is never a confusing hybrid of the two sources.
const emPage = await getEmdashBrandPage(slug)
const mdPage = emPage
  ? null
  : (await getCollection('brandPage')).find((entry) => entry.data.brand === slug) ?? null

const name = brand?.name ?? emPage?.name ?? mdPage?.id ?? slug
const blurb = emPage?.blurb || mdPage?.data.blurb || brand?.story || ''
const slideshow = emPage?.slideshow ?? mdPage?.data.slideshow ?? []
const cards = emPage?.collectionCards ?? mdPage?.data.collectionCards ?? []
const heroImage = slideshow[0] ?? null

// Extended copy: Portable Text blocks from the CMS, or the markdown body.
const story = emPage?.story ?? null
const Body = mdPage ? (await render(mdPage)).Content : null

// Related reading, previously computed in getStaticPaths — same logic, now at
// request time.
const relatedPosts = (await getCollection('post'))
  .filter((post) => (post.data.brands ?? []).includes(slug))
  .sort((a, b) => b.data.date - a.data.date)

// The facts list replaces the design's mock rows (Founded / Archive / Made in /
// Held at Atelier) with the four we can actually source: the founded year stated
// in the house's own story, the country, how many designs of theirs we hold, and
// how we hold them. "Archive: 25,000+ documents" is Pierre Frey copy with no
// field behind it, so it is not invented for every house.
//
// The count is a safeFetch: a page must still render when the API is down, and
// this brand may be editorial-only.
const { data: held } = await safeFetch(
  `/catalogue/products?brand=${encodeURIComponent(slug)}&limit=1`
)
const designCount = held?.meta?.total ?? null
const founded = foundedYear(brand ?? { story: blurb })

// The collections grid is driven by the live catalogue and only decorated by
// the editorial cards above. The gate is BRAND-level — the section shows when
// Atelier holds products under the house (designCount, already fetched for the
// facts list), whether or not memberships are assigned yet; a memberless
// collection's tile falls back to the house grid so it never lands empty (see
// lib/collections.js). safeFetch because this page must render with the API
// down — the section degrades away, like the facts that depend on the API.
const { data: collectionsBody } = await safeFetch(
  `/catalogue/collections?brand=${encodeURIComponent(slug)}`
)
const tiles = collectionTiles({
  collections: collectionsBody?.collections ?? [],
  cards,
  brandSlug: slug,
  brandHasProducts: (designCount ?? 0) > 0,
})

const facts = [
  founded ? { label: 'Founded', value: String(founded) } : null,
  brand?.country ? { label: 'Made in', value: brand.country } : null,
  designCount ? { label: 'Designs held', value: `${designCount}` } : null,
  { label: 'Held at Atelier', value: 'By the metre, cut to order' },
].filter(Boolean)

// The banner eyebrow: "The Maisons · France · est. 1935".
const heroEyebrow = ['The Maisons', brand?.country, founded ? `est. ${founded}` : null]
  .filter(Boolean)
  .join(' · ')

const dateFormat = new Intl.DateTimeFormat('en-NZ', { dateStyle: 'long' })

// Only a genuine miss 404s: the API answered and has no such brand, AND no
// editorial page exists in either source. An API outage renders whatever
// editorial we have (offline-safe), and an editorial page for a slug the API
// does not know still renders — that union was the seeded-page behaviour before
// this route went live and it is preserved.
const notFound = !brand && !apiDown && !emPage && !mdPage
if (notFound) {
  Astro.response.status = 404
}
---

<Layout title={`${name} — Atelier Textiles`} bleed>
  {
    notFound ? (
      <div class="container brand-missing">
        <p class="breadcrumb">
          <a href="/brands">← All houses</a>
        </p>
        <h1>House not found</h1>
        <p class="empty-state">We could not find that house.</p>
      </div>
    ) : (
      <>
        <section
          class:list={['brand-hero', 'bleed-hero', { weave: !heroImage }]}
          style={heroImage ? `background-image: url(${heroImage})` : undefined}
        >
          <div class="bleed-hero-body">
            <div class="container">
              <p class="bleed-hero-eyebrow">{heroEyebrow}</p>
              <h1>{name}</h1>
            </div>
          </div>
        </section>

        <section class="container brand-intro">
          <div class="brand-intro-body">
            <div class="brass-rule" />
            {blurb && <p class="brand-lede">{blurb}</p>}
            {story && (
              <div class="brand-copy">
                <PortableText value={story} />
              </div>
            )}
            {Body && (
              <div class="brand-copy">
                <Body />
              </div>
            )}
            {
              // The intro action sends the reader to the house's own site (the
              // client's rule); the shop path lives in the collection tiles
              // below. No website on file -> no button, not a dead link.
              brand?.website_url && (
                <a
                  class="btn btn-lg"
                  href={brand.website_url}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  Visit {name}
                </a>
              )
            }
          </div>

          <dl class="spec-rows brand-facts">
            {facts.map((fact) => (
              <div>
                <dt>{fact.label}</dt>
                <dd>{fact.value}</dd>
              </div>
            ))}
          </dl>
        </section>

        {tiles.length > 0 && (
          <section class="brand-collections">
            <div class="container">
              <p class="eyebrow-brass">This season</p>
              <h2>
                {countWord(tiles.length)}{' '}
                <em>{tiles.length === 1 ? 'collection' : 'collections'}</em>
              </h2>
              <div class="brand-collection-grid">
                {tiles.map((tile) => (
                  <a class="brand-collection" href={tile.href}>
                    <span class="scrim-tile brand-collection-media">
                      {tile.image ? (
                        <img src={tile.image} alt="" loading="lazy" />
                      ) : (
                        <span class="scrim-tile-media weave" aria-hidden="true" />
                      )}
                      <span class="scrim-tile-label">{tile.heading}</span>
                    </span>
                    {tile.description && (
                      <span class="brand-collection-note">{tile.description}</span>
                    )}
                  </a>
                ))}
              </div>
            </div>
          </section>
        )}

        {relatedPosts.length > 0 && (
          <section class="band-dark brand-reading">
            <div class="container">
              <div class="band-dark-head">
                <h2>
                  Related <em>reading</em>
                </h2>
                <a class="band-dark-link" href="/resources">
                  The journal
                </a>
              </div>
              <ul class="index-list">
                {relatedPosts.map((post) => (
                  <li>
                    <a href={`/resources/${post.id}`}>
                      <span class="index-name brand-reading-title">{post.data.title}</span>
                      <span class="index-meta brand-reading-date">
                        {dateFormat.format(post.data.date)}
                      </span>
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          </section>
        )}
      </>
    )
  }
</Layout>
