---
export const prerender = false // live: API brand + EmDash/markdown editorial overlay
import { getCollection, render } from 'astro:content'
import { PortableText } from 'emdash/ui'
import brandsBanner from '../../assets/img/brands-hero-bg.jpg'
import { houseArtwork } from '../../lib/houses.js'
import Layout from '../../layouts/Layout.astro'
import { apiFetch, ApiError, safeFetch } from '../../lib/api.js'
import BespokeEnquiry from '../../components/BespokeEnquiry.jsx'
import { collectionTiles } from '../../lib/collections.js'
import { bespokeHouseFor } from '../../lib/bespoke.js'
import { getEmdashBrandPage } from '../../lib/emdash.js'

// One house page, 2026 direction, resolved per request so a brand created in
// /admin/brands or a page published in the EmDash CMS appears without a
// rebuild.
//
// It renders BOTH of the Figma's house frames, because they are the same page
// drawn twice:
//   - "Brand Page" (9350:479) — a full-bleed photographic banner with the
//     header floating over it, the country as a badge above the house name.
//   - "Product Page" (9350:788) — identical from the intro down; the banner is
//     replaced by an umber title band. It is not a product-detail screen: the
//     tiles below it are still collections and the copy is still a house blurb.
// The switch is simply whether the house has banner photography, which is what
// the two frames differ on. Fourteen of the houses the API seeds are
// represented-only and have no imagery at all, so the band variant is the one
// most of the directory actually renders.
//
// Then: the intro column beside the facts rows, the full-bleed collection tile
// wall, and the related-reading band. The page is `bleed`, and `overlay`
// whenever there is a banner for the header to float over.
const { slug } = Astro.params

// The brand itself comes from the live catalogue API. apiFetch (not safeFetch)
// because the two failure modes need different handling: a 404 means "no such
// brand" (an editorial-only page may still exist), while any other failure
// means the API is down and we must NOT 404 a brand that really exists.
let brand = null
let apiDown = false
try {
  const body = await apiFetch(`/catalogue/brands/${encodeURIComponent(slug)}`)
  brand = body?.brand ?? null
} catch (err) {
  if (!(err instanceof ApiError) || err.status !== 404) apiDown = true
}

// Editorial precedence: EMDASH WINS OVER MARKDOWN here. This deliberately
// diverges from /resources, where markdown wins — brand pages are handed to the
// CMS as the editor of record (it is the whole point of wiring them through
// EmDash), while the markdown files under src/content/brands stay as the
// offline baseline that ships with the repo. Precedence is per PAGE, not per
// field: the markdown entry is only read when the CMS has nothing for this
// slug, so a page is never a confusing hybrid of the two sources.
const emPage = await getEmdashBrandPage(slug)
const mdPage = emPage
  ? null
  : (await getCollection('brandPage')).find((entry) => entry.data.brand === slug) ?? null

const name = brand?.name ?? emPage?.name ?? mdPage?.id ?? slug
// The two CRM text fields (16 Sep 2026): the HEADLINE opens the left column,
// the STORY is the body copy — on the right for an ordinary house, under the
// headline for a bespoke one (whose right column is the enquiry form). The
// editorial blurb, where the CMS has one, sits under the headline.
const headline = brand?.headline ?? null
const houseStory = brand?.story ?? null
const blurb = emPage?.blurb || mdPage?.data.blurb || ''
const slideshow = emPage?.slideshow ?? mdPage?.data.slideshow ?? []
const cards = emPage?.collectionCards ?? mdPage?.data.collectionCards ?? []
// The provenance line ("France · est. 1935", degrading to the country alone).
// It used to be the banner's right-hand aside; the country is already the
// badge over the name, so it now sits under the headline instead.
// `brandsBanner.src` and not getImage(): this page is `prerender = false`, so
// under `output: "server"` getImage() returns a RUNTIME `/_image` URL, and that
// endpoint is not resolved on staging — every house without its own slideshow
// opened on a blank hero there (Userback, 14 Sep 2026, de Le Cuona). The
// imported asset is emitted to `/_astro/` at build time and served statically.

// Extended copy: Portable Text blocks from the CMS, or the markdown body.
const story = emPage?.story ?? null
const Body = mdPage ? (await render(mdPage)).Content : null

// The facts list replaces the design's mock rows (Founded / Archive / Made in /
// Held at Atelier) with the four we can actually source: the founded year stated
// in the house's own story, the country, how many designs of theirs we hold, and
// how we hold them. "Archive: 25,000+ documents" is Pierre Frey copy with no
// field behind it, so it is not invented for every house.
//
// The count is a safeFetch: a page must still render when the API is down, and
// this brand may be editorial-only.
const { data: held } = await safeFetch(
  `/catalogue/products?brand=${encodeURIComponent(slug)}&limit=12`
)
const designCount = held?.meta?.total ?? null

// The house directory stays PUBLIC — it is marketing, and the API still lists
// every house to everyone. What is gated is what Atelier HOLDS: for a house
// with `trade_only` the anonymous product count above comes back 0, so "View
// all products" and the collection tiles simply are not there for a guest. The
// page used to carry a trade note about that (a guest apply/sign-in block, then
// only the approved-account "held for the trade" island); the office asked for
// it gone in both forms (Userback, Sept 2026) — the grid's own banner is where
// the gate is explained, and a house page is about the house.

// A house the CRM flags `bespoke` takes made-to-measure commissions: its page
// carries the quote enquiry form (moved here from /bespoke) in the right-hand
// column, and the body copy joins the blurb on the left so the intro stays a
// text-and-form pair. Null for every other house, which keeps the redraw's
// two text columns.
const bespokeHouse = brand?.bespoke ? bespokeHouseFor(brand) : null

// The collections grid is driven by the live catalogue and only decorated by
// the editorial cards above. It shows whenever the house HAS collections — the
// product-count gate it used to carry is gone, because the tile wall is the
// design's own route into a house and a house with collections and no wall
// reads as a house we hold nothing from (see lib/collections.js). safeFetch
// because this page must render with the API down — the section degrades away,
// like the facts that depend on the API.
const { data: collectionsBody } = await safeFetch(
  `/catalogue/collections?brand=${encodeURIComponent(slug)}`
)
const tiles = collectionTiles({
  collections: collectionsBody?.collections ?? [],
  cards,
  brandSlug: slug,
})

// The banner is the SAME photograph the house's tile on /brands shows (16 Sep
// 2026: "make sure the images for each brand are also the same for the
// individual brand page"): the one artwork chain, lib/houses.js — the CRM's
// house image, then the editorial slideshow, then a collection's photograph,
// then a design's. The client's brands photograph is the floor under all four.
const firstImage = (rows) => rows.find((row) => row?.image_url)?.image_url ?? null
const heroImage = houseArtwork(
  {
    editorial: { [slug]: slideshow[0] ?? null },
    collections: { [slug]: firstImage(collectionsBody?.collections ?? []) },
    catalogue: { [slug]: firstImage(held?.products ?? []) },
  },
  { slug, image_url: brand?.image_url ?? null }
)

// The FALLBACK route into the house's designs. The mock's brand page has one
// action — "Visit website" — because the collection tiles below it are how a
// shopper gets to the grid; so this appears only where there is no tile wall to
// do that job, and then only where the grid it lands on has something in it.
// Both flags are named here rather than inline because the actions row must
// know whether it will have ANY child: rendered unconditionally it painted an
// empty bordered box on every house with no website on file (Userback,
// 14 Sep 2026).
const showAllProducts = tiles.length === 0 && (designCount ?? 0) > 0
const showActions = Boolean(brand?.website_url) || showAllProducts

// Only a genuine miss 404s: the API answered and has no such brand, AND no
// editorial page exists in either source. An API outage renders whatever
// editorial we have (offline-safe), and an editorial page for a slug the API
// does not know still renders — that union was the seeded-page behaviour before
// this route went live and it is preserved.
const notFound = !brand && !apiDown && !emPage && !mdPage
if (notFound) {
  Astro.response.status = 404
}
---

<Layout title={`${name} — Atelier Textiles`} bleed overlay={!notFound} dark={!notFound}>
  {
    notFound ? (
      <div class="container house-missing">
        <p class="breadcrumb">
          <a href="/brands">← All houses</a>
        </p>
        <h1>House not found</h1>
        <p class="empty-state">We could not find that house.</p>
      </div>
    ) : (
      <>
        {/* The Story page's hero, exactly: full-viewport parallax photograph,
            the header floating in it, the country badge and the house name at
            the foot on the left, one line on the right. A house with no banner
            photography of its own opens on the client's brands photograph —
            never the umber band it used to get (page feedback, Sept 2026:
            "no hero banner"). Below: the frame's intro (9379:2657), two TEXT
            columns — the blurb on the left, the body copy and the actions on
            the right. */}
        <section class="photo-band photo-band--parallax house-banner">
          <span class="photo-band-art" style={`background-image: url('${heroImage ?? brandsBanner.src}')`}></span>
          <div class="container photo-band-body">
            <div class="photo-band-row">
              <div class="house-banner-copy">
                {brand?.country && <p class="badge-light">{brand.country}</p>}
                <h1 class="photo-band-title">{name}</h1>
              </div>
              {/* No right-hand aside: it printed the country a second time
                  (16 Sep 2026, "redundant"). The provenance line moved under
                  the headline below. */}
            </div>
          </div>
        </section>
        <section class="house-intro">
          <div class="container house-intro-inner">
            <div class="house-intro-blurb">
              {headline && <p class="house-headline">{headline}</p>}
              {blurb && <p class="house-lede">{blurb}</p>}
              {
                // A bespoke house's story sits under the headline, because the
                // right-hand column is the enquiry form. Same blocks as
                // below; the column is the only difference.
                bespokeHouse && houseStory && (
                  <div class="house-copy">
                    <p>{houseStory}</p>
                  </div>
                )
              }
              {
                bespokeHouse && story && (
                  <div class="house-copy">
                    <PortableText value={story} />
                  </div>
                )
              }
              {bespokeHouse && Body && (
                <div class="house-copy">
                  <Body />
                </div>
              )}
              {
                // The actions sit under the bio in the LEFT column, not above
                // the enquiry form on the right (Userback, 14 Sep 2026: "move
                // this button here"). Rendered only when one of them will show.
                showActions && (
                  <div class="house-actions">
                    {/* The house's own website (the client's rule). No URL on
                        file -> no action, not a dead link. */}
                    {brand?.website_url && (
                      <a
                        class="cta-underline"
                        href={brand.website_url}
                        target="_blank"
                        rel="noopener noreferrer"
                      >
                        Visit website
                      </a>
                    )}
                    {showAllProducts && (
                      <a class="cta-underline" href={`/products?brand=${slug}`}>
                        View all products
                      </a>
                    )}
                  </div>
                )
              }
            </div>

            <div class="house-intro-body">
              {!bespokeHouse && houseStory && (
                <div class="house-copy">
                  <p>{houseStory}</p>
                </div>
              )}
              {!bespokeHouse && story && (
                <div class="house-copy">
                  <PortableText value={story} />
                </div>
              )}
              {!bespokeHouse && Body && (
                <div class="house-copy">
                  <Body />
                </div>
              )}

              {
                // The quote form, an island because it posts and prefills from
                // the session; server-rendered first so the fields are in the
                // HTML.
                bespokeHouse && <BespokeEnquiry client:load house={bespokeHouse} />
              }
            </div>
          </div>
        </section>

        {tiles.length > 0 && (
          <section class="tile-wall house-collections">
            {tiles.map((tile) => (
              <a class:list={['tile', { weave: !tile.image }]} href={tile.href}>
                {tile.image && (
                  <span class="tile-art" style={`background-image: url('${tile.image}')`} />
                )}
                <span class="tile-body">
                  <span class="tile-heading">
                    {tile.season && <span class="badge-light">{tile.season}</span>}
                    <span class="tile-title">{tile.heading}</span>
                  </span>
                  <span class="cta-underline cta-underline-light">View collection</span>
                </span>
              </a>
            ))}
          </section>
        )}
      </>
    )
  }
</Layout>
