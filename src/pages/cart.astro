---
export const prerender = true // storefront pages stay static; EmDash routes render on-demand
import Layout from '../layouts/Layout.astro'
import Cart from '../components/Cart.jsx'

// Cart page (US-019). The cart lives entirely in localStorage, so the whole
// page is a client:load React island (quantity edit / remove / subtotal).
---

<Layout title="Cart — Atelier Textiles" description="Review the finished goods in your cart before checkout." bleed overlay="light">
  {/* The shop page's banner, exactly (page feedback, Sept 2026): the light
      band with the header floating in it, badge + headline at its foot on
      the left, one line of copy on the right; the page under it on the
      shop's own air (`.library-shell`). */}
  <section class="library-hero">
    <div class="container library-hero-row">
      <div class="library-hero-heading">
        <p class="badge-ochre">Cart</p>
        <h1>Your cart</h1>
      </div>
      <p class="library-hero-note">Finished goods ready to purchase. Fabrics are ordered separately by request.</p>
    </div>
  </section>

  <div class="container library-shell">
    <Cart client:load />
  </div>
</Layout>
