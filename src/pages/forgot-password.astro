---
export const prerender = true // storefront pages stay static; EmDash routes render on-demand
import { getImage } from 'astro:assets'
import Layout from '../layouts/Layout.astro'
import ForgotPasswordForm from '../components/ForgotPasswordForm.jsx'
import signInArt from '../assets/img/sign-in-bg.jpg'

// Wears the sign-in screen (login.astro) unchanged: same photograph, same
// scrim, same centred column. The form is a client:load island.
const backdrop = await getImage({ src: signInArt, format: 'webp' })
---

<Layout title="Forgot password — Atelier Textiles" description="Request a link to reset your Atelier Textiles password." bleed overlay>
  <section class="auth-screen" style={`background-image: url('${backdrop.src}')`}>
    <div class="auth-screen-body">
      <h1 class="auth-screen-title">Forgot your password?</h1>
      <p class="auth-screen-note">Enter the email you sign in with and we will send you a link to choose a new one.</p>
      <ForgotPasswordForm client:load />
    </div>
  </section>
</Layout>
