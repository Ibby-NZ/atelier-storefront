---
export const prerender = false // on-demand so a newly created product resolves without a rebuild
import Layout from '../../layouts/Layout.astro'
import ProductDetail from '../../components/ProductDetail.jsx'

// Product detail page (US-018). Rendered on demand rather than prerendered:
// staff create products through /admin/products at runtime, and a prerendered
// route set would 404 every new slug until the next deploy.
//
// Nothing is fetched here — the interactive detail (live availability, trade
// pricing behind the auth cookie) is a client:load React island that fetches
// GET /catalogue/products/:slug per request and renders its own not-found
// state, so this page never needs the API at build OR at request time.
const { slug } = Astro.params
---

<Layout title="Product — Atelier Textiles" description="Product details, colourways, and availability.">
  <ProductDetail client:load slug={slug} />
</Layout>
