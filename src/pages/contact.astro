---
// On demand since the CMS took the intro copy: an edit to the EmDash `pages`
// entry "contact" must show without a rebuild. The markdown page stays the
// offline baseline, same precedence rule as the brand pages (CMS wins).
export const prerender = false
import Layout from '../layouts/Layout.astro'
import { getEntry, render } from 'astro:content'
import { PortableText } from 'emdash/ui'
import ContactForm from '../components/ContactForm.jsx'
import { getEmdashPage } from '../lib/emdash.js'
import { CONTACT, SHOWROOMS, SHOWROOM_HOURS, SOCIAL } from '../lib/site.js'

// Contact page. The welcoming intro is editable content — the EmDash `pages`
// entry "contact" first, the markdown `page` collection as the baseline; the
// contact details, showrooms and the enquiry form come from src/lib/site.js +
// the ContactForm island (posts to POST /contact, which stores + emails).
const emPage = await getEmdashPage('contact')
const entry = emPage ? null : await getEntry('page', 'contact')
const Content = entry ? (await render(entry)).Content : null
const title = emPage?.title || (entry?.data.title ?? 'Contact')
---

<Layout
  title={`${title} — Atelier Textiles`}
  description="Contact Atelier Textiles for samples, trade enquiries, stock checks and cut requirements. Trade showrooms in Auckland, Wellington and Christchurch."
  dark
>
  <article class="content-page contact-page">
    {/* Two columns from the top (page feedback, Sept 2026 — the form sits
        beside the headline, not under the intro): the head, the ways in and
        the three showrooms on the left; the enquiry form on its panel on the
        right, top-aligned with the headline. */}
    <div class="contact-layout">
      <div class="contact-copy">
        <header class="contact-head">
          <h1>{title}</h1>
          {
            emPage?.content && (
              <div class="prose">
                <PortableText value={emPage.content} />
              </div>
            )
          }
          {
            !emPage?.content && Content && (
              <div class="prose">
                <Content />
              </div>
            )
          }
        </header>

        <section class="contact-details" aria-label="Contact details">
          {/* The two ways in, set large in the display face — a page whose one
              job is to be reached should not file its email in a table. */}
          <div class="contact-reach">
            <a class="contact-reach-link" href={`mailto:${CONTACT.email}`}>{CONTACT.email}</a>
            <a class="contact-reach-link" href={`tel:${CONTACT.phoneHref}`}>{CONTACT.phone}</a>
            <p class="contact-reach-note">{CONTACT.freephone}</p>
          </div>

          {/* The showrooms as three tiles, the city as each one's title. */}
          <ul class="contact-showrooms">
            {
              SHOWROOMS.map((s) => (
                <li class="contact-showroom">
                  <p class="contact-showroom-city">{s.city}</p>
                  <p class="contact-showroom-name">{s.name}</p>
                  <p class="contact-showroom-lines">
                    {s.lines.map((line) => <span>{line}</span>)}
                  </p>
                </li>
              ))
            }
          </ul>

          <p class="contact-foot">
            <span>{SHOWROOM_HOURS} · Trade showrooms, by appointment.</span>
            <span class="contact-foot-links">
              {
                SOCIAL.map((link) => (
                  <a class="cta-underline" href={link.href} target="_blank" rel="noopener noreferrer">
                    {link.label}
                  </a>
                ))
              }
            </span>
          </p>
        </section>
      </div>

      <section class="contact-form-panel" aria-label="Send an enquiry">
        <h2>Send an enquiry</h2>
        <ContactForm client:load />
      </section>
    </div>
  </article>
</Layout>
