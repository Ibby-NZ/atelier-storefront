---
export const prerender = true // storefront pages stay static; EmDash routes render on-demand
import Layout from '../layouts/Layout.astro'
import Account from '../components/Account.jsx'

// My Account (US-022). Everything inside is a client:load island: auth state,
// orders, samples, invoices and price lists are all per-session (cookie), so
// none of it can be prerendered. An unauthenticated visitor is redirected to
// /login?redirect=/account.
//
// The sections live in the URL hash rather than as separate routes — see
// Account.jsx. That keeps this one prerendered shell for every panel.
---

<Layout
  title="My Account — Atelier Textiles"
  description="Your Atelier Textiles orders, samples, invoices and trade price lists."
>
  <section class="page-intro">
    <p class="page-eyebrow">Trade account</p>
    <h1>My account</h1>
    <p>Your orders, samples, invoices and price lists in one place.</p>
  </section>

  <Account client:load />
</Layout>
