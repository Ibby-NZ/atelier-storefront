---
export const prerender = true // storefront pages stay static; EmDash routes render on-demand
import Layout from '../layouts/Layout.astro'
import RequestList from '../components/RequestList.jsx'

// Request-list page (US-020). The list of fabrics a shopper has built lives
// entirely in localStorage, so the whole page is a client:load React island:
// per-line metres and cut requirements, remove, contact details, and one
// `POST /orders/request` carrying every line.
//
// The legacy deep link `/order-request?product=<slug>[&sku=][&backorder=1]`
// still works — the island adds that colourway to the list on arrival and then
// strips the query.
---

<Layout
  title="Your request list — Atelier Textiles"
  description="Review the fabrics you are requesting, set the metres and cut requirements, and send them as one request. We reply within 24 hours."
>
  <section class="page-intro">
    <p class="page-eyebrow">Cut to order</p>
    <h1>Your request list</h1>
    <p>
      Fabric is cut to order. Add as many cloths as you like, tell us how much you need of each
      and any cut requirements — we verify stock and batch shading before invoicing, and reply
      within 24 hours.
    </p>
  </section>

  <RequestList client:load />
</Layout>
