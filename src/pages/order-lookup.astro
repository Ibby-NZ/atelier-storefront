---
export const prerender = true // storefront pages stay static; EmDash routes render on-demand
import Layout from '../layouts/Layout.astro'
import OrderLookupForm from '../components/OrderLookupForm.jsx'

// Guest order-lookup page (US-022). A visitor without an account finds an order
// by number + email via GET /orders/lookup. Public — no auth needed.
---

<Layout
  title="Track an Order — Atelier Textiles"
  description="Look up the status of an Atelier Textiles order with your order number and email."
>
  <section class="page-intro">
    <h1>Track an order</h1>
    <p>Enter your order number and the email used when ordering. Have an account? <a href="/account">View all your orders</a>.</p>
  </section>

  <OrderLookupForm client:load />
</Layout>
