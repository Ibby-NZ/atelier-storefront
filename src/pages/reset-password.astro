---
export const prerender = true // storefront pages stay static; EmDash routes render on-demand
import { getImage } from 'astro:assets'
import Layout from '../layouts/Layout.astro'
import ResetPasswordForm from '../components/ResetPasswordForm.jsx'
import signInArt from '../assets/img/sign-in-bg.jpg'

// Wears the sign-in screen (login.astro) unchanged: same photograph, same
// scrim, same centred column. The form is a client:load island.
const backdrop = await getImage({ src: signInArt, format: 'webp' })
---

<Layout title="Reset password — Atelier Textiles" description="Choose a new password for your Atelier Textiles account." bleed overlay>
  <section class="auth-screen" style={`background-image: url('${backdrop.src}')`}>
    <div class="auth-screen-body">
      <h1 class="auth-screen-title">Choose a new password</h1>
      <p class="auth-screen-note">Pick something at least 12 characters long. You will sign in with it straight away.</p>
      <ResetPasswordForm client:load />
    </div>
  </section>
</Layout>
