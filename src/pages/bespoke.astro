---
export const prerender = true // storefront pages stay static; EmDash routes render on-demand
import Layout from '../layouts/Layout.astro'
import { getImage } from 'astro:assets'
import BespokeExplorer from '../components/BespokeExplorer.jsx'
// The client's own supply for this page (Sept 2026, 2070 × 1376).
import heroArt from '../assets/img/bespoke-hero-bg.jpg'

const hero = await getImage({ src: heroArt, format: 'webp', width: 2200 })

// Bespoke (made-to-measure) page — client brief of 10 Aug 2026. Five houses
// take custom commissions; all five are on the page at once as a wall of
// cards, and picking one opens its images and a short blurb. No pricing
// anywhere: every piece is quoted, and the enquiry posts to POST /contact with
// the house in the subject line. The houses' stock items stay in the shop
// under each brand's name, separately.
---

<Layout
  title="Bespoke — Atelier Textiles"
  description="Made-to-measure area rugs, furniture, bedding, table linen, throws and cushions from Pierre Frey, C&C Milano, Loro Piana Interiors, Maria Flora and de Le Cuona. Every piece individually quoted."
  bleed
  overlay
  dark
>
  {/* The Brands page's opening, reused: a full-viewport photo band with the
      header floating inside it, the headline left and one line of copy right
      (page feedback, Sept 2026: "make it look like the brands page"). */}
  <section class="photo-band photo-band--parallax bespoke-hero">
    <span class="photo-band-art" style={`background-image: url(${hero.src});`}></span>
    <div class="container photo-band-body">
      <div class="photo-band-row">
        <h1 class="photo-band-title">
          <span class="photo-band-title-sub">Made to measure</span>
          Bespoke, by the maisons
        </h1>
        <div class="photo-band-aside">
          <p>
            Beyond the bolt, five of our houses make pieces entirely to order:
            area rugs, furniture, bedding, table linen, throws and cushions,
            sized and finished to your scheme. Every commission is quoted
            individually.
          </p>
        </div>
      </div>
    </div>
  </section>

  {/* The wall — the same section, head and rhythm as the Brands page's wall of
      houses; the explorer's cards are drawn to the same 371 × 497 tile. */}
  <section class="container house-wall">
    <div class="house-wall-head">
      <h2>Choose a house</h2>
    </div>
    <BespokeExplorer client:load />
  </section>
</Layout>
