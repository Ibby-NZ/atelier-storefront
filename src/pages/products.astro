---
export const prerender = true // storefront pages stay static; EmDash routes render on-demand
import Layout from '../layouts/Layout.astro'
import ProductLibrary from '../components/ProductLibrary.jsx'

// Product library page (US-017), 2026 direction (design: Figma "Products Page",
// node 9379:2732).
//
// The page opens on a full-bleed umber band with the header floating inside it
// (`bleed overlay`): an "Explore" badge over the display headline on the left,
// which reads "Products" (Userback, 25 Aug 2026) — the page is the whole
// library, and "Collections" named one of its facets rather than the page,
// the library's one line of copy on the right, both anchored to the foot of the
// band. The band and the browse area each carry their own `.container`, which
// keeps the content column aligned with the header wordmark and the footer.
//
// The grid and every control below the band are one client:load React island
// reading GET /catalogue/products — the sidebar facets and the results share
// state, so they live in the same island.
---

<Layout
  title="Products — Atelier Textiles"
  description="Search the full Atelier Textiles library of fabrics and finished goods by house, application, composition and colourway."
  bleed
  overlay
  darkGround
>
  <section class="library-hero">
    <div class="container library-hero-row">
      <div class="library-hero-heading">
        <p class="badge-light">Explore</p>
        <h1>Products</h1>
      </div>
      <p class="library-hero-note">
        Every design we hold, from the houses we represent and our own workroom.
      </p>
    </div>
  </section>

  <div class="container library-shell">
    <ProductLibrary client:load />
  </div>
</Layout>
