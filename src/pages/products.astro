---
export const prerender = true // storefront pages stay static; EmDash routes render on-demand
import Layout from '../layouts/Layout.astro'
import ProductLibrary from '../components/ProductLibrary.jsx'

// Product library page (US-017). The grid + filters are fully interactive, so
// the whole thing is a client:load React island reading GET /catalogue/products.
// Filtering happens in the browser with no page reload.
---

<Layout title="Products — Atelier Textiles" description="Search the full Atelier Textiles library of fabrics and finished goods by house, application, composition and colourway.">
  <section class="page-intro">
    <p class="page-eyebrow">The Collection</p>
    <h1>The <em>Library</em></h1>
    <p>
      Every design we hold, from the houses we represent and our own workroom.
      Search or filter by house, application, composition and more.
    </p>
  </section>

  <ProductLibrary client:load />
</Layout>
