---
export const prerender = true // storefront pages stay static; EmDash routes render on-demand
import Layout from '../layouts/Layout.astro'
import ProductLibrary from '../components/ProductLibrary.jsx'

// Product library page (US-017), Maison direction (design: "Maison Library").
//
// The page is `bleed` so the linen page-header band paints edge to edge; the
// band and the browse area each carry their own `.container`, which keeps the
// content column aligned with the site header and footer.
//
// The grid and every control below the band are one client:load React island
// reading GET /catalogue/products — the sidebar facets and the results share
// state, so they live in the same island.
---

<Layout
  title="Products — Atelier Textiles"
  description="Search the full Atelier Textiles library of fabrics and finished goods by house, application, composition and colourway."
  bleed
>
  <section class="library-head">
    <div class="container">
      <div class="page-intro">
        <p class="page-eyebrow">The Collection</p>
        <h1>The <em>Library</em></h1>
        <p>Every design we hold, from the houses we represent and our own workroom.</p>
      </div>
    </div>
  </section>

  <div class="container library-shell">
    <ProductLibrary client:load />
  </div>
</Layout>
