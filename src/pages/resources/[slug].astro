---
export const prerender = false // resolves the live EmDash post first, else the markdown baseline
import Layout from '../../layouts/Layout.astro'
import { getEntry, render } from 'astro:content'
import { PortableText } from 'emdash/ui'
import { getEmdashPost } from '../../lib/emdash.js'
import { excerptFromBody } from '../../lib/journal.js'
import { safeFetch } from '../../lib/api.js'

// One journal post. A post published in the EmDash CMS (US-026) is the editor
// of record and wins on its slug; the markdown `post` collection is only read
// when the CMS has nothing for it (per post, never a hybrid — the brand pages'
// rule, see lib/posts.js). Server-rendered so the CMS is queried live. When
// neither source has the slug we return a 404 body.
const { slug } = Astro.params

const emPost = await getEmdashPost(slug)
const mdPost = emPost ? null : await getEntry('post', slug)
let Content = null
if (mdPost) {
  Content = (await render(mdPost)).Content
}

const found = emPost ?? mdPost

const title = emPost?.title ?? mdPost?.data.title ?? 'Not found'
const date = emPost?.date ?? mdPost?.data.date ?? null
const hero = emPost?.hero ?? mdPost?.data.hero ?? null
const brandSlugs = emPost?.brands ?? mdPost?.data.brands ?? []

// The standfirst doubles as the page's meta description, so a post is
// shareable without anyone writing a second summary.
const excerpt = emPost
  ? emPost.excerpt
  : mdPost
    ? mdPost.data.excerpt ?? excerptFromBody(mdPost.body)
    : ''

// A tag showed the raw slug ("pierre-frey"). The house names come from the
// catalogue API; safeFetch never throws, so a missing/unavailable API just
// leaves the tag on its slug rather than failing the page. Skipped entirely
// when the post tags no houses.
const { data: brandList } = brandSlugs.length
  ? await safeFetch('/catalogue/brands')
  : { data: null }

const brandNames = (brandList?.brands ?? []).reduce(
  (names, brand) => ({ ...names, [brand.slug]: brand.name }),
  {}
)

const brands = brandSlugs.map((houseSlug) => ({
  slug: houseSlug,
  name: brandNames[houseSlug] ?? houseSlug,
}))

const formattedDate = date
  ? new Intl.DateTimeFormat('en-NZ', { dateStyle: 'long' }).format(date)
  : ''

if (!found) {
  Astro.response.status = 404
}
---

<Layout
  title={`${title} — Atelier Textiles`}
  description={excerpt || 'Collection stories and house notes from Atelier Textiles.'}
  image={hero ?? undefined}
  type="article"
>
  {
    !found ? (
      <div class="not-found">
        <p class="breadcrumb">
          <a href="/resources">← The journal</a>
        </p>
        <h1>Story not found</h1>
        <p>
          That post could not be found. It may have been moved or is no longer
          published.
        </p>
        <a class="btn" href="/resources">
          Read the journal
        </a>
      </div>
    ) : (
      <article class="post">
        <p class="breadcrumb">
          <a href="/resources">← The journal</a>
        </p>

        <header class="post-header">
          <div class="brass-rule" />
          <p class="eyebrow-wide">The Atelier Journal</p>
          <h1>{title}</h1>
          {formattedDate && <span class="post-date">{formattedDate}</span>}
          {brands.length > 0 && (
            <p class="post-brands">
              {brands.map((brand) => (
                <a class="tag" href={`/brands/${brand.slug}`}>
                  {brand.name}
                </a>
              ))}
            </p>
          )}
        </header>

        {hero && <img class="post-hero" src={hero} alt={title} />}

        <div class="prose">
          {
            /* Markdown body, else the CMS post's Portable Text body. The
               excerpt is only a last resort — before US-018's companion fix an
               EmDash post rendered its excerpt and dropped the whole body. */
            Content ? (
              <Content />
            ) : emPost?.content ? (
              <PortableText value={emPost.content} />
            ) : (
              <p>{emPost?.excerpt}</p>
            )
          }
        </div>

        <footer class="post-footer">
          <a class="link-cta" href="/resources">
            More from the journal
          </a>
        </footer>
      </article>
    )
  }
</Layout>
