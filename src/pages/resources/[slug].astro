---
export const prerender = false // resolves markdown baseline first, else live EmDash post
import Layout from '../../layouts/Layout.astro'
import { getEntry, render } from 'astro:content'
import { PortableText } from 'emdash/ui'
import { getEmdashPost } from '../../lib/emdash.js'
import { excerptFromBody } from '../../lib/journal.js'
import { safeFetch } from '../../lib/api.js'

// One journal post. The markdown `post` collection is the baseline and wins on
// slug collisions; a slug with no markdown entry falls back to a post authored
// in the EmDash CMS (US-026). Server-rendered so the CMS is queried live. When
// neither source has the slug we return a 404 body.
const { slug } = Astro.params

const mdPost = await getEntry('post', slug)
let Content = null
if (mdPost) {
  Content = (await render(mdPost)).Content
}

const emPost = mdPost ? null : await getEmdashPost(slug)
const found = mdPost ?? emPost

const title = mdPost?.data.title ?? emPost?.title ?? 'Not found'
const date = mdPost?.data.date ?? emPost?.date ?? null
const hero = mdPost?.data.hero ?? emPost?.hero ?? null
const brandSlugs = mdPost?.data.brands ?? []

// The standfirst doubles as the page's meta description, so a post is
// shareable without anyone writing a second summary.
const excerpt = mdPost
  ? mdPost.data.excerpt ?? excerptFromBody(mdPost.body)
  : emPost?.excerpt ?? ''

// A tag showed the raw slug ("pierre-frey"). The house names come from the
// catalogue API; safeFetch never throws, so a missing/unavailable API just
// leaves the tag on its slug rather than failing the page. Skipped entirely
// when the post tags no houses.
const { data: brandList } = brandSlugs.length
  ? await safeFetch('/catalogue/brands')
  : { data: null }

const brandNames = (brandList?.brands ?? []).reduce(
  (names, brand) => ({ ...names, [brand.slug]: brand.name }),
  {}
)

const brands = brandSlugs.map((houseSlug) => ({
  slug: houseSlug,
  name: brandNames[houseSlug] ?? houseSlug,
}))

const formattedDate = date
  ? new Intl.DateTimeFormat('en-NZ', { dateStyle: 'long' }).format(date)
  : ''

if (!found) {
  Astro.response.status = 404
}

// The share links carry this page's own address and title, URL-encoded once.
const shareUrl = encodeURIComponent(Astro.url.href)
const shareText = encodeURIComponent(title)
---

<Layout
  title={`${title} — Atelier Textiles`}
  description={excerpt || 'Collection stories and house notes from Atelier Textiles.'}
  image={hero ?? undefined}
  type="article"
  bleed
>
  {
    !found ? (
      <div class="not-found">
        <p class="breadcrumb">
          <a href="/resources">← The journal</a>
        </p>
        <h1>Story not found</h1>
        <p>
          That post could not be found. It may have been moved or is no longer
          published.
        </p>
        <a class="btn" href="/resources">
          Read the journal
        </a>
      </div>
    ) : (
      <article class="post">
        <div class="container">
          <section class:list={['photo-band', 'photo-band--parallax', 'post-hero', { weave: !hero }]}>
            {hero && <span class="photo-band-art" style={`background-image: url(${hero})`}></span>}
            <div class="photo-band-body post-hero-body">
              <p class="badge-light">The Atelier Journal</p>
              <h1 class="photo-band-title">{title}</h1>
            </div>
          </section>
          <div class="post-meta">
            <nav class="post-crumbs" aria-label="Breadcrumb">
              <a href="/">Home</a>
              <span class="post-crumbs-sep" aria-hidden="true">/</span>
              <a href="/resources">Journal</a>
              <span class="post-crumbs-sep" aria-hidden="true">/</span>
              <span aria-current="page">{title}</span>
            </nav>
            <div class="post-meta-right">
              {brands.length > 0 && (
                <p class="post-brands">
                  {brands.map((brand) => (
                    <a class="badge-ochre" href={`/brands/${brand.slug}`}>
                      {brand.name}
                    </a>
                  ))}
                </p>
              )}
              {formattedDate && <span class="post-date">{formattedDate}</span>}
            </div>
          </div>
          <div class="prose post-body">
            {
              /* Markdown body, else the CMS post's Portable Text body. The
                 excerpt is only a last resort — before US-018's companion fix an
                 EmDash post rendered its excerpt and dropped the whole body. */
              Content ? (
                <Content />
              ) : emPost?.content ? (
                <PortableText value={emPost.content} />
              ) : (
                <p>{emPost?.excerpt}</p>
              )
            }
          </div>
          <footer class="post-footer">
            <a class="cta-underline" href="/resources">
              More from the journal
            </a>
            <div class="post-share" aria-label="Share">
              <ul>
                <li>
                  <a href={`https://www.facebook.com/sharer/sharer.php?u=${shareUrl}`} target="_blank" rel="noopener noreferrer" aria-label="Share on Facebook">
                    <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M13.5 22v-8h2.7l.4-3.2h-3.1V8.8c0-.9.3-1.6 1.6-1.6h1.7V4.4c-.3 0-1.3-.1-2.5-.1-2.5 0-4.1 1.5-4.1 4.2v2.3H7.4V14h2.8v8h3.3z"/></svg>
                  </a>
                </li>
                <li>
                  <a href={`https://twitter.com/intent/tweet?url=${shareUrl}&text=${shareText}`} target="_blank" rel="noopener noreferrer" aria-label="Share on X">
                    <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.5 3h3l-6.6 7.6L21.7 21h-6.1l-4.8-6.2L5.3 21h-3l7.1-8.1L2 3h6.2l4.3 5.7L17.5 3zm-1.1 16.2h1.7L7.4 4.7H5.6l10.8 14.5z"/></svg>
                  </a>
                </li>
                <li>
                  <a href={`https://www.linkedin.com/sharing/share-offsite/?url=${shareUrl}`} target="_blank" rel="noopener noreferrer" aria-label="Share on LinkedIn">
                    <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M6.4 8.6H3.1V21h3.3V8.6zM4.8 3.2a1.9 1.9 0 100 3.8 1.9 1.9 0 000-3.8zM21 13.4c0-3.6-1.9-5.2-4.5-5.2-2 0-3 1.1-3.5 1.9V8.6H9.7c0 .9 0 12.4 0 12.4H13v-6.9c0-.4 0-.7.1-1 .3-.7.9-1.5 2-1.5 1.4 0 2 1.1 2 2.7V21H21v-7.6z"/></svg>
                  </a>
                </li>
                <li>
                  <a href={`mailto:?subject=${shareText}&body=${shareUrl}`} aria-label="Share by email">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="0"/><path d="M3 7l9 6 9-6"/></svg>
                  </a>
                </li>
              </ul>
            </div>
          </footer>
        </div>
      </article>
    )
  }
</Layout>
