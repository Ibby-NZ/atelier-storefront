---
// On demand since the CMS took this page: an edit to the EmDash `pages` entry
// "terms" must show without a rebuild. The markdown `page` collection stays
// the offline baseline (CMS wins, page-level precedence — never a hybrid).
export const prerender = false
import Layout from '../layouts/Layout.astro'
import { getEntry, render } from 'astro:content'
import { PortableText } from 'emdash/ui'
import { getEmdashPage } from '../lib/emdash.js'

// One of the design's last two footer links (Figma 7307:930). Editable in the
// EmDash admin (Pages → "terms") or via src/content/pages/terms.md — the
// markdown ships placeholder copy until the client's own lands (Sept 2026).
const emPage = await getEmdashPage('terms')
const entry = emPage ? null : await getEntry('page', 'terms')
const Content = entry ? (await render(entry)).Content : null
const title = emPage?.title || (entry?.data.title ?? 'Terms & Conditions')
---

<Layout title={`${title} — Atelier Textiles`} bleed overlay="light">
  {/* The shop page's banner, then the copy on the container's full width —
      the legal pages open exactly as /products and /resources do. */}
  <section class="library-hero">
    <div class="container library-hero-row">
      <div class="library-hero-heading">
        <p class="badge-ochre">Atelier Textiles</p>
        <h1>{title}</h1>
      </div>
    </div>
  </section>

  <article class="container library-shell legal-page">
    {
      emPage?.content ? (
        <div class="prose">
          <PortableText value={emPage.content} />
        </div>
      ) : Content ? (
        <div class="prose">
          <Content />
        </div>
      ) : (
        <p class="empty-state">This page has no content yet.</p>
      )
    }
  </article>
</Layout>
