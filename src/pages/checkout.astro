---
export const prerender = true // storefront pages stay static; EmDash routes render on-demand
import Layout from '../layouts/Layout.astro'
import Checkout from '../components/Checkout.jsx';

// Checkout page (US-019). Shipping-zone selector, live quote, order total, and
// "Pay by Card" (redirects to Stripe). Reads the cart from localStorage, so the
// whole page is a client:load island.
---

<Layout title="Checkout — Atelier Textiles" description="Choose your delivery region and pay securely by card." bleed overlay="light">
  {/* The shop page's banner, exactly (page feedback, Sept 2026): the light
      band with the header floating in it, badge + headline at its foot on
      the left, one line of copy on the right; the page under it on the
      shop's own air (`.library-shell`). */}
  <section class="library-hero">
    <div class="container library-hero-row">
      <div class="library-hero-heading">
        <p class="badge-ochre">Secure payment</p>
        <h1>Checkout</h1>
      </div>
      <p class="library-hero-note">Choose your delivery region, then pay securely by card with Stripe.</p>
    </div>
  </section>

  <div class="container library-shell">
    <ol class="checkout-steps" aria-label="Checkout steps">
      <li><a href="/cart">Cart</a></li>
      <li aria-current="step">Checkout</li>
      <li>Secure payment</li>
    </ol>
    <Checkout client:load />
  </div>
</Layout>
