---
export const prerender = true // storefront pages stay static; EmDash routes render on-demand
import Layout from '../layouts/Layout.astro'
import RegisterForm from '../components/RegisterForm.jsx'

// Register page (US-021). The form is a client:load island posting to
// POST /auth/register (role=customer); on success it redirects home and the
// header account island shows the new account name.
---

<Layout
  title="Create an account — Atelier Textiles"
  description="Create an Atelier Textiles account to place orders and track them."
>
  <section class="page-intro">
    <p class="page-eyebrow">Account</p>
    <h1>Create an <em>account</em></h1>
    <p>Register to place orders and track them from your account.</p>
  </section>

  <RegisterForm client:load />
</Layout>
